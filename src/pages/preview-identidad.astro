---
// src/pages/preview-identidad.astro
// Link publico de vista previa (Helvetica + Dorado). Solo funciona si el admin
// lo activo desde el panel (boton "Preview" -> /api/admin/preview-identity).
// Si esta apagado, muestra la pantalla de mantenimiento (502) — asi, si alguien
// descubre la URL, no ve nada del cambio a menos que este activo.
import { getConfig } from '../lib/analytics-db.js';
import MaintenanceScreen from '../components/MaintenanceScreen.astro';

export const prerender = false;

const enabled = (await getConfig('preview_identity_enabled').catch(() => null)) === '1';
if (!enabled) Astro.response.status = 502;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title>GO · Preview identidad</title>
  {enabled ? (
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { height: 100%; width: 100%; overflow: hidden; background: #111; }
      #bar {
        position: fixed; top: 0; left: 0; right: 0; z-index: 999;
        height: 48px; display: flex; align-items: center; justify-content: center;
        gap: 14px; background: #111; color: #fff; font: 600 13px/1 system-ui, sans-serif;
      }
      #bar .dot { width: 8px; height: 8px; border-radius: 50%; background: #d4af37; }
      iframe {
        position: fixed; top: 48px; left: 0; right: 0; bottom: 0;
        width: 100%; height: calc(100% - 48px); border: none;
      }
    </style>
  ) : (
    <style>*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}</style>
  )}
</head>
<body>
  {enabled ? (
    <>
      <div id="bar">
        <span class="dot"></span>
        <span>VISTA PREVIA — Helvetica + Dorado</span>
      </div>
      <iframe id="frame" src="/es/"></iframe>
      <script>
        const frame = document.getElementById('frame');
        function apply() {
          const doc = frame.contentDocument;
          if (!doc) return;
          doc.documentElement.classList.add('admin-preview-identity');
        }
        frame.addEventListener('load', apply);
      </script>
    </>
  ) : (
    <MaintenanceScreen
      codigo="502"
      titulo="Estamos mejorando esta sección"
      mensaje="Volvemos en unos momentos."
      accion="none"
      anim={true}
    />
  )}
</body>
</html>
