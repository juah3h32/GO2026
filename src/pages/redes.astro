---
export const prerender = true;
import "../styles/typography.css";
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Grupo Ortiz · Redes</title>
  <meta name="description" content="Todas las redes sociales de Grupo Ortiz en un solo lugar." />
  <meta name="robots" content="noindex, follow" />
  <meta name="theme-color" content="#0F0E0C" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
</head>
<body>
  <main class="redes-page">
    <div class="redes-card">
      <img src="/images/logo/Logo.svg" alt="Grupo Ortiz" class="redes-logo" />
      <p class="redes-tag">Nuestras redes</p>

      <div class="redes-list">
        <a class="redes-link" href="https://www.facebook.com/people/Grupo-Ort%C3%ADz/61559817857366/" target="_blank" rel="noopener noreferrer">
          <span class="redes-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </span>
          <span class="redes-label">Facebook</span>
        </a>

        <a class="redes-link" href="https://www.instagram.com/grupoortiz_mexico?igsh=dWJtbHhrN3A2d254" target="_blank" rel="noopener noreferrer">
          <span class="redes-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </span>
          <span class="redes-label">Instagram</span>
        </a>

        <a class="redes-link" href="https://www.linkedin.com/company/grupo-ortiz-mx/posts/?feedView=all" target="_blank" rel="noopener noreferrer">
          <span class="redes-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </span>
          <span class="redes-label">LinkedIn</span>
        </a>

        <a class="redes-link" href="https://www.tiktok.com/@grupo_ortiz_oficial?_r=1&_t=ZS-98C7mFX5frJ" target="_blank" rel="noopener noreferrer">
          <span class="redes-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M16.6 5.82a4.28 4.28 0 0 1-2.63-3.33h-2.9v13.66a2.6 2.6 0 1 1-2.6-2.6c.19 0 .38.02.57.05v-2.94a5.55 5.55 0 0 0-.57-.03A5.54 5.54 0 1 0 14 16.15V9.4a7.24 7.24 0 0 0 4.2 1.34V7.85a4.28 4.28 0 0 1-1.6-.32z"/>
            </svg>
          </span>
          <span class="redes-label">TikTok</span>
        </a>

        <a class="redes-link" href="https://wa.me/524433575815?text=Me%20podr%C3%ADa%20dar%20m%C3%A1s%20informaci%C3%B3n%20sobre%20sus%20productos" target="_blank" rel="noopener noreferrer">
          <span class="redes-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.6 6.32A7.85 7.85 0 0 0 12.05 4a7.94 7.94 0 0 0-6.9 11.9L4 20l4.2-1.1a7.9 7.9 0 0 0 3.85 1h.01a7.94 7.94 0 0 0 5.54-13.58zm-5.55 12.2h-.01a6.6 6.6 0 0 1-3.36-.92l-.24-.14-2.5.65.67-2.44-.16-.25a6.6 6.6 0 1 1 5.6 3.1zm3.62-4.94c-.2-.1-1.17-.58-1.35-.64-.18-.07-.31-.1-.44.1-.13.2-.5.64-.62.77-.11.13-.23.14-.43.05-.2-.1-.83-.31-1.58-.98a5.94 5.94 0 0 1-1.1-1.37c-.11-.2 0-.3.09-.4.09-.1.2-.23.3-.35.1-.11.13-.2.2-.33.06-.13.03-.25-.02-.35-.05-.1-.44-1.06-.6-1.45-.16-.38-.32-.33-.44-.34h-.38c-.13 0-.34.05-.52.25-.18.2-.68.66-.68 1.62s.7 1.87.8 2 1.36 2.08 3.3 2.92c.46.2.82.32 1.1.4.46.15.88.13 1.21.08.37-.06 1.17-.48 1.34-.94.16-.46.16-.86.11-.94-.05-.09-.18-.14-.38-.24z"/>
            </svg>
          </span>
          <span class="redes-label">WhatsApp</span>
        </a>
      </div>

      <p class="redes-copy">&copy; {new Date().getFullYear()} Grupo Ortiz, SA. de CV.</p>
    </div>
  </main>
</body>
</html>

<style>
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: #0F0E0C;
    font-family: 'NeueMontreal', sans-serif;
    overflow: hidden;
    overscroll-behavior: none;
  }
  .redes-page {
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(14px, 4vh, 40px) 20px;
    overflow: hidden;
  }
  .redes-card {
    width: 100%;
    max-width: 420px;
    height: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .redes-logo {
    width: clamp(90px, 16vh, 140px);
    height: auto;
    margin-bottom: clamp(12px, 3vh, 28px);
    flex-shrink: 0;
  }
  .redes-tag {
    color: #a3a3a3;
    font-size: clamp(11px, 1.6vh, 13px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 clamp(12px, 3vh, 24px) 0;
    flex-shrink: 0;
  }
  .redes-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.8vh, 14px);
    flex-shrink: 1;
    min-height: 0;
  }
  .redes-link {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: clamp(10px, 2vh, 16px) 20px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.03);
    color: #fff;
    text-decoration: none;
    font-size: clamp(13px, 1.8vh, 15px);
    font-weight: 500;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }
  .redes-link:hover {
    border-color: #fb670b;
    background: rgba(251,103,11,0.08);
    transform: translateY(-2px);
  }
  .redes-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fb670b;
    flex-shrink: 0;
  }
  .redes-label {
    flex: 1;
    text-align: left;
  }
  .redes-copy {
    margin-top: clamp(12px, 3vh, 32px);
    color: #6b6b6b;
    font-size: 11px;
    flex-shrink: 0;
  }
</style>
