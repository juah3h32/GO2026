---
// src/pages/[lang]/vacantes.astro
import "../../styles/vacantes.css";
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import VacantesPage from "../../components/VacantesPage.jsx";
import VacantesNotifPrompt from "../../components/VacantesNotifPrompt.jsx";
import { translations } from "../../i18n";
import { readProductVideos } from "../../lib/analytics-db.js";

const { lang } = Astro.params;
const currentLang = (lang && lang in translations) ? lang : "es";

// ── Video del hero (mismo que antes) ──────────────────────────────────────
const CLOUD      = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;
const VIDEO_ID    = "GO/vacantes/video";
const posterUrl  = `https://res.cloudinary.com/${CLOUD}/video/upload/f_jpg,q_auto,so_0/GO/vacantes/video.jpg`;

const bunnyVideos = await readProductVideos();
const BUNNY_PULLZONE = import.meta.env.PUBLIC_BUNNY_PULLZONE_HOSTNAME;
const vacantesVideoSrc = bunnyVideos['vacantes-hero']
  ? `https://${BUNNY_PULLZONE}/${bunnyVideos['vacantes-hero']}/play_1080p.mp4`
  : `https://res.cloudinary.com/${CLOUD}/video/upload/q_auto:best/${VIDEO_ID}.mp4`;

const benefits = [
  {
    title: "Prestaciones de ley",
    desc:  "IMSS, vacaciones, aguinaldo y todo lo que te corresponde desde el primer día.",
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    title: "Empresa consolidada",
    desc:  "Más de 65 años de trayectoria. Estabilidad laboral real en una empresa líder de México.",
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/></svg>`,
  },
  {
    title: "Crecimiento interno",
    desc:  "Promovemos el talento de nuestro equipo. Muchos líderes empezaron en piso de planta.",
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`,
  },
  {
    title: "Ambiente de trabajo",
    desc:  "Instalaciones modernas en Morelia. Equipo comprometido y cultura de respeto.",
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
];

const steps = [
  { num:"01", title:"Abre el asistente", desc:"Haz clic aquí para abrir el asistente. Te guiará paso a paso.", openBot: true },
  { num:"02", title:"Completa tu perfil", desc:"Comparte tu nombre, edad, puesto de interés y adjunta tu CV si lo tienes." },
  { num:"03", title:"Recibe confirmación", desc:"Tu solicitud llega directamente al área de Recursos Humanos." },
  { num:"04", title:"Espera contacto",    desc:"RH revisará tu perfil y se comunicará contigo a la brevedad posible." },
];
---

<BaseLayout
  title="Vacantes en Morelia | Empleos Grupo Ortiz"
  description="Únete al equipo de Grupo Ortiz en Morelia, Michoacán. Vacantes disponibles en producción, almacén, logística, ventas y más. Regístrate con nuestro asistente virtual."
  canonicalSlug="vacantes/"
  currentLang={currentLang}
>

  <Fragment slot="head">
    <link rel="preload" as="image" href={posterUrl} fetchpriority="high" />
    <style is:inline>
      html.ocultar-salto {
        opacity: 0 !important;
        pointer-events: none !important;
      }
    </style>

    <script is:inline>
      if (window.location.hash === '#vacantes') {
        document.documentElement.classList.add('ocultar-salto');
      }
    </script>
  </Fragment>

  <!-- Función global que abre el bot -->
<style is:inline>
    /* Hace la página transparente temporalmente si viene con un salto */
    html.ocultar-salto {
      opacity: 0 !important;
      transition: opacity 0.15s ease-in; /* Aparece suavemente una vez acomodada */
    }
  </style>

  <script is:inline>
    // 1. Acción Inmediata: Si hay un hash, ocultamos el HTML ANTES de que el navegador lo dibuje
    if (window.location.hash) {
      document.documentElement.classList.add('ocultar-salto');
    }

    function openBot(detail) {
      window.dispatchEvent(new CustomEvent('botgo:open-vacancy', { detail: detail || {} }));
    }

    window.addEventListener('vacantes:expand', () => {
      const header = document.getElementById('vacantes-header');
      if (header) header.classList.add('is-sticky');
    });

    function forcePinToHash() {
      const hash = window.location.hash;
      
      // Si no hay hash, nos aseguramos de que la página sea visible y terminamos
      if (!hash) {
        document.documentElement.classList.remove('ocultar-salto');
        return;
      }

      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }

      let attempts = 0;
      
      const pinScroll = setInterval(() => {
        const target = document.querySelector(hash);
        
        if (target && target.getBoundingClientRect().height > 10) {
          const offsetPosition = target.getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({ top: offsetPosition, behavior: 'instant' });
          
          // 2. ¡La magia! Hacemos visible la página EXACTAMENTE cuando ya forzamos el salto
          document.documentElement.classList.remove('ocultar-salto');
        }
        
        attempts++;
        if (attempts > 40) {
          clearInterval(pinScroll);
          // Seguro anti-fallos: Si pasan 800ms, mostramos la página de todos modos
          document.documentElement.classList.remove('ocultar-salto'); 
        }
      }, 20); 
    }

    document.addEventListener('astro:page-load', forcePinToHash);
    
    if (document.readyState === 'complete') {
      forcePinToHash();
    } else {
      window.addEventListener('load', forcePinToHash);
    }
  </script>

  <div class="vac-page">

    <!-- ════════════════════════════════
         HERO — texto + video + franja de beneficios superpuesta
    ═════════════════════════════════ -->
    <section class="vac-hero2">
      <div class="vac-hero2__media">
        <video
          class="vac-hero2__video"
          src={vacantesVideoSrc}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={posterUrl}
        ></video>
        <div class="vac-hero2__veil"></div>
      </div>

      <div class="vac-hero2__inner">

        <div class="vac-hero2__content">
          <p class="vac-hero2__eyebrow"><span class="vac-hero2__dash"></span>Talento GO</p>
          <h1 class="vac-hero2__title">Construye tu historia con <em>nosotros</em></h1>
          <p class="vac-hero2__sub">
            Más que un empleo, una oportunidad para crecer, aprender y ser parte
            de una empresa que impulsa el valor en México y el mundo.
          </p>

          <div class="vac-hero2__ctas">
            <a
              href="#vacantes"
              class="btn btn--solid"
              onclick="event.preventDefault(); document.getElementById('vacantes')?.scrollIntoView({ behavior: 'smooth' }); window.history.pushState(null, '', '#vacantes');"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 8V4H8"/><rect x="4" y="8" width="16" height="12" rx="2"/>
                <path d="M2 14h2"/><path d="M20 14h2"/><path d="M9 13v2"/><path d="M15 13v2"/>
              </svg>
              Postularme ahora
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="https://go-radar.com.mx/seguimiento" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              Seguimiento en GO Radar
            </a>
          </div>
        </div>

      </div>

      <!-- Franja de beneficios — superpuesta al borde inferior del hero -->
      <div class="vac-hero2__benefits">
        {benefits.map(b => (
          <div class="vac-hero2__benefit">
            <div class="vac-hero2__benefit-icon">
              <Fragment set:html={b.svg} />
            </div>
            <div>
              <div class="vac-hero2__benefit-title">{b.title}</div>
              <div class="vac-hero2__benefit-desc">{b.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════════════════════════════
         VACANTES DINÁMICAS
    ═════════════════════════════════ -->
    <section class="vac-section vac-section--alt" id="vacantes">
      <div class="vac-section-inner">

        <div id="vacantes-header" class="vac-section__header">
          <p class="section-tag">Oportunidades abiertas</p>
          <h2 class="section-heading">Vacantes en <em>Morelia</em></h2>
        </div>

        <VacantesPage client:visible />

      </div>
    </section>

    <!-- ════════════════════════════════
         CÓMO REGISTRARTE
    ═════════════════════════════════ -->
    <section class="vac-section" id="como-aplicar">
      <div class="vac-section-inner">

        <div class="vac-section__header">
          <p class="section-tag">Proceso de registro</p>
          <h2 class="section-heading">Aplica en <em>minutos</em></h2>
        </div>

        <div class="vac-steps-grid">
          {steps.map(s => (
            s.openBot ? (
              <button class="vac-step vac-step--bot" onclick="openBot()">
                <div class="vac-step-num">{s.num}</div>
                <div>
                  <div class="vac-step-title">
                    {s.title}
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left:6px;vertical-align:middle;opacity:0.7"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </div>
                  <div class="vac-step-desc">{s.desc}</div>
                </div>
              </button>
            ) : (
              <div class="vac-step">
                <div class="vac-step-num">{s.num}</div>
                <div>
                  <div class="vac-step-title">{s.title}</div>
                  <div class="vac-step-desc">{s.desc}</div>
                </div>
              </div>
            )
          ))}
        </div>

      </div>
    </section>

    <Footer currentLang={currentLang} />

  </div>

  <VacantesNotifPrompt client:idle />

</BaseLayout>