  <script>
    // pdf-lib: fusiona ArrayBuffers de PDFs en uno solo y numera paginas. Expuesto a scripts inline.
    import { PDFDocument, StandardFonts, rgb } from 'pdf-lib';
    window.__pdfMerge = async function(arrayBuffers) {
      const merged = await PDFDocument.create();
      // coverCount: cuantas paginas al inicio NO se numeran (portada general = 1)
      const coverCount = 1;
      for (const buf of arrayBuffers) {
        try {
          const doc = await PDFDocument.load(buf, { ignoreEncryption: true });
          const pages = await merged.copyPages(doc, doc.getPageIndices());
          pages.forEach(p => merged.addPage(p));
        } catch(e) { console.warn('[pdfMerge] skip:', e.message); }
      }
      // Numerar paginas: empezar despues de la portada general
      try {
        const font = await merged.embedFont(StandardFonts.Helvetica);
        const total = merged.getPageCount();
        const numberedPages = total - coverCount;
        for (let i = coverCount; i < total; i++) {
          const page = merged.getPage(i);
          const { width, height } = page.getSize();
          const pageNum = i - coverCount + 1;
          const txt = pageNum + ' / ' + numberedPages;
          const fontSize = 9;
          const tw = font.widthOfTextAtSize(txt, fontSize);
          page.drawText(txt, {
            x: width - tw - 20,
            y: 14,
            size: fontSize,
            font,
            color: rgb(0.55, 0.55, 0.55),
            opacity: 0.65,
          });
        }
      } catch(e) { console.warn('[pdfMerge] page numbers:', e.message); }
      return merged.save();
    };
  </script>

