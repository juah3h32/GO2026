---
// src/pages/[lang]/catalogo-digital.astro
// Catalogo digital animado — division STRETCH FILM.
// Diseno y datos espejo de las laminas oficiales del Product Catalog.
// SSR: lee el catalogo de Turso en cada request -> refleja cambios al instante (Vercel).
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Footer from "../../../components/Footer.astro";
import { translations } from "../../../i18n";
import { getCatalog } from "../../../lib/catalog-store.js";
import { getCatalogMeta, listCatalogsMeta } from "../../../lib/catalogs.js";

const { lang, category } = Astro.params;
const currentLang = (lang as string) || "es";
const slug = category || "digital-stretch-film";
const meta = getCatalogMeta(slug);
const catalogData: any = await getCatalog(slug);
const { productos, fichas, intro, coverImg, visualCover } = catalogData;
const catalogStyles = catalogData.styles || {};
const cover = catalogData.cover || { t1: "STRETCH", t2: "FILM", division: "" };
const imgFolder = meta.imgFolder || "stretch";
const coverFolder = meta.coverImgFolder || "catalogos";

// Acepta URL absoluta (Cloudinary), ruta local, o nombre de archivo.
const IMG = (n: string) => /^https?:\/\//.test(n) ? n : (n.startsWith('/') ? n : `/images/${imgFolder}/${n}`);
const IMG_CAT = (n: string) => /^https?:\/\//.test(n) ? n : (n.startsWith('/') ? n : `/images/${coverFolder}/${n}`);

// Valores seguros para la portada
const vc = visualCover || { scale: 1, offsetX: 0, offsetY: 0, rotate: 0 };

// Helper de traduccion para el JSON
// Quita el simbolo ® de cualquier texto (regla: nunca debe salir en catalogo ni PDF)
const stripR = (s: any) => typeof s === 'string' ? s.replace(/®/g, '') : s;
const T = (obj: any) => {
  if (obj && typeof obj === 'object' && !Array.isArray(obj)) {
    const v = obj[currentLang];
    if (v !== undefined && v !== null && v !== '') return stripR(v);
    return obj.es !== undefined && obj.es !== null ? stripR(obj.es) : '';
  }
  return obj == null ? '' : stripR(obj);
};

// Traducimos los datos antes de inyectarlos
const introTr = {
  p1: T(intro.p1),
  bioTitle: T(intro.bioTitle),
  p2: T(intro.p2)
};
const coverTr = {
  t1: T(cover.t1),
  t2: T(cover.t2),
  division: T(cover.division)
};
// La lista de portada se deriva de los nombres de las fichas: si borras/renombras una ficha,
// la portada se actualiza sola (quedan siempre vinculadas). Fallback al array productos legacy.
const productosTr = (Array.isArray(fichas) && fichas.length) ? fichas.map(f => T(f.nombre)) : productos.map(T);
const manyProds = productosTr.length > 3; // >3: lista horizontal al pie, deja arriba libre para la imagen
const _ne = (v: any) => v !== '' && v !== null && v !== undefined;
const fichasTr = fichas.map(f => {
  const specs = (f.specs || []).map(s => ({ ...s, c: T(s.c), tol: T(s.tol), min: T(s.min), max: T(s.max), uni: T(s.uni), met: T(s.met) }));
  const cols = {
    min: specs.some(s => _ne(s.min)),
    max: specs.some(s => _ne(s.max)),
    tol: specs.some(s => _ne(s.tol)),
    uni: specs.some(s => _ne(s.uni)),
    met: specs.some(s => _ne(s.met)),
  };
  // single = solo un valor por fila (sin rango min/max): ej bolsas (Ancho/Alto/Material/Uso)
  const single = cols.min && !cols.max;
  // pares para tabla simple a 2 columnas-par (llena el ancho, no se ve vacia)
  const specPairs = [];
  if (single) { for (let i = 0; i < specs.length; i += 2) specPairs.push([{ s: specs[i], i }, specs[i + 1] ? { s: specs[i + 1], i: i + 1 } : null]); }
  return { ...f, nombre: T(f.nombre), desc: T(f.desc), specs, cols, single, specPairs };
});

const dc: any = (translations[currentLang] as any)?.digital_catalog || {};
const common: any = (translations[currentLang] as any)?.common || {};
// Diccionario UI de la portada/tabla (fallback garantizado por idioma; i18n puede estar incompleto)
const UI: any = {
  es: { downloadPDF: 'Descargar PDF', distributor: 'Quiero ser distribuidor', products: 'Productos', characteristics: 'CARACTERÍSTICAS', measurement: 'MEDICIÓN', tolerances: 'TOLERANCIAS', unit: 'UNIDAD', testMethod: 'MÉTODO DE PRUEBA', min: 'MÍNIMO', max: 'MÁXIMO', value: 'VALOR', soon: 'PRÓXIMAMENTE', soonNote: 'Este producto estará disponible pronto.', titlePart1: 'CATÁLOGO DE', titlePart2: 'PRODUCTOS', division: 'DIVISIÓN' },
  en: { downloadPDF: 'Download PDF', distributor: 'Become a distributor', products: 'Products', characteristics: 'CHARACTERISTICS', measurement: 'MEASUREMENT', tolerances: 'TOLERANCES', unit: 'UNIT', testMethod: 'TEST METHOD', min: 'MINIMUM', max: 'MAXIMUM', value: 'VALUE', soon: 'COMING SOON', soonNote: 'This product will be available soon.', titlePart1: 'CATALOG OF', titlePart2: 'PRODUCTS', division: 'DIVISION' },
  pt: { downloadPDF: 'Baixar PDF', distributor: 'Quero ser distribuidor', products: 'Produtos', characteristics: 'CARACTERÍSTICAS', measurement: 'MEDIÇÃO', tolerances: 'TOLERÂNCIAS', unit: 'UNIDADE', testMethod: 'MÉTODO DE TESTE', min: 'MÍNIMO', max: 'MÁXIMO', value: 'VALOR', soon: 'EM BREVE', soonNote: 'Este produto estará disponível em breve.', titlePart1: 'CATÁLOGO DE', titlePart2: 'PRODUTOS', division: 'DIVISÃO' },
  zh: { downloadPDF: '下载 PDF', distributor: '成为分销商', products: '产品', characteristics: '特性', measurement: '测量', tolerances: '公差', unit: '单位', testMethod: '测试方法', min: '最小值', max: '最大值', value: '数值', soon: '即将推出', soonNote: '该产品即将上市。', titlePart1: '产品', titlePart2: '目录', division: '部门' },
  ar: { downloadPDF: 'تنزيل PDF', distributor: 'كن موزعًا', products: 'المنتجات', characteristics: 'الخصائص', measurement: 'القياس', tolerances: 'التفاوتات', unit: 'الوحدة', testMethod: 'طريقة الاختبار', min: 'الحد الأدنى', max: 'الحد الأقصى', value: 'القيمة', soon: 'قريباً', soonNote: 'سيتوفر هذا المنتج قريباً.', titlePart1: 'كتالوج', titlePart2: 'المنتجات', division: 'قسم' }
};
const ui: any = UI[currentLang] || UI.es;
const ctTitle: any = { es: 'Catálogo de Productos | Grupo Ortiz', en: 'Product Catalog | Grupo Ortiz', pt: 'Catálogo de Produtos | Grupo Ortiz', zh: '产品目录 | Grupo Ortiz', ar: 'كتالوج المنتجات | Grupo Ortiz' };
const t: any = {
  catalogTitle: dc.title || ctTitle[currentLang] || ctTitle.es,
  catalogTitlePart1: dc.titlePart1 || ui.titlePart1,
  catalogTitlePart2: dc.titlePart2 || ui.titlePart2,
  downloadPDF: dc.downloadPDF || ui.downloadPDF,
  distributor: dc.distributor || ui.distributor,
  products: dc.products || ui.products,
  characteristics: dc.characteristics || ui.characteristics,
  measurement: dc.measurement || ui.measurement,
  tolerances: dc.tolerances || ui.tolerances,
  unit: dc.unit || ui.unit,
  testMethod: dc.testMethod || ui.testMethod,
  min: dc.min || ui.min,
  max: dc.max || ui.max,
  value: ui.value,
  soon: ui.soon,
  soonNote: ui.soonNote,
  division: common.division || ui.division
};

// Etiquetas tabla de medidas por color (traducidas)
const CT_LABELS: any = {
  es: { color: 'Color', in: 'Medidas (pulgadas)', yd: 'Medidas (yardas)' },
  en: { color: 'Color', in: 'Measures (inches)', yd: 'Measures (yards)' },
  pt: { color: 'Cor', in: 'Medidas (polegadas)', yd: 'Medidas (jardas)' },
  zh: { color: '颜色', in: '尺寸（英寸）', yd: '尺寸（码）' },
  ar: { color: 'اللون', in: 'القياسات (بوصة)', yd: 'القياسات (ياردة)' }
};
const ctl = CT_LABELS[currentLang] || CT_LABELS.es;

---

<BaseLayout
  title={t.catalogTitle || "Catálogo de Productos — Stretch Film | Grupo Ortiz"}
  description="Catálogo digital de la división Stretch Film de Grupo Ortiz: Manual Convencional, Banding, Preestirado, Automático y Rígido con especificaciones técnicas."
  canonicalSlug={`catalogo/${slug}/`}
  currentLang={currentLang}
  moveLogoMobile={true}
>
  <main class="cd">
    <div class="cd-ed-guides" aria-hidden="true"></div>
    <div class="cd-deck" id="cdDeck">

    <!-- ── HERO / PORTADA DIVISION ──────────────────────────────── -->
    <section class={`cd-slide cd-hero ${manyProds ? "cd-hero-prodrow" : ""}`}>
      <header class="cd-bar cd-bar-sec">
        <div></div>
        <div class="cd-site"><span class="cd-site-line"></span>GRUPO-ORTIZ.COM</div>
      </header>
      <div class="cd-hero-media">
        <div style={`transform: translate(${vc.offsetX}%, ${vc.offsetY}%) scale(${vc.scale}) rotate(${vc.rotate || 0}deg); overflow: ${vc.clip ? 'hidden' : 'visible'}; transition: transform 0.1s ease;`}>
          <img src={IMG_CAT(coverImg)} alt="Rollo de stretch film Grupo Ortiz" loading="eager" decoding="async" style={`transform: scale(${vc.zoom || 1});${(vc.clipTop || vc.clipBottom) ? ` clip-path: inset(${vc.clipTop || 0}% 0 ${vc.clipBottom || 0}% 0);` : ''}`} />
        </div>
      </div>
      <div class="cd-hero-inner">
        <h1 class="cd-hero-title">
          <span class="cd-w cd-orange reveal" data-cd-path="cover.t1">{coverTr.t1}</span>
          {coverTr.t2 && <span class="cd-w cd-gray reveal" style="--d:.1s" data-cd-path="cover.t2">{coverTr.t2}</span>}
        </h1>
        <div class="cd-hero-div reveal" style="--d:.18s" data-cd-path="cover.division">{coverTr.division || t.division || "DIVISIÓN"}</div>
        <div class="cd-hero-copy reveal" style="--d:.26s">
          <p data-cd-path="intro.p1">{introTr.p1}</p>
          <p class="cd-bio-t" data-cd-path="intro.bioTitle">{introTr.bioTitle}</p>
          <p data-cd-path="intro.p2">{introTr.p2}</p>
        </div>
        <div class="cd-hero-actions reveal" style="--d:.4s">
          <a class="cd-dl" id="cdDownload" href={`/api/catalogo-pdf?lang=${currentLang}&catalog=${slug}`} download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span class="cd-dl-txt">{t.downloadPDF || "Descargar PDF"}</span>
          </a>
          <button class="cd-dl cd-dl-general cd-ed-h" id="cdDownloadGeneral" type="button" aria-label="Descargar catálogo general con todas las divisiones">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span class="cd-dl-txt">Catálogo General</span>
          </button>
          <a class="cd-btn-hero" href={`/${currentLang}/distribuidor`}>
            <span>{t.distributor || "Quiero ser distribuidor"}</span>
            <i class="cd-chevs" style="font-size: 1.2em; margin-left: 4px;">&raquo;</i>
          </a>
        </div>
      </div>
      <div class="cd-hero-prods reveal" style="--d:.34s">
        <span class="cd-prods-t">{t.products || "Productos"}:</span>
        <ul>
          {productosTr.map((p, i) => (<li style={`--d:${0.36 + i * 0.05}s`} data-cd-path={`fichas.${i}.nombre`}>- {p}</li>))}
        </ul>
      </div>
      <div class="cd-year">2026</div>
    </section>

    <!-- ── FICHAS TECNICAS ──────────────────────────────────────── -->
    {fichasTr.map((f, idx) => (
      <section class={`cd-slide cd-ficha ${f.lado === "left" ? "is-left" : ""} ${f.soon ? "is-soon" : ""}`}>
        <div class="cd-ficha-bg" aria-hidden="true"></div>

        <header class="cd-bar cd-bar-sec">
          <div class="cd-logo">
            <span class="cd-logo-1">{t.catalogTitlePart1 || "CATÁLOGO DE"}</span>
            <span class="cd-logo-2"><i class="cd-chevs">&raquo;</i>{t.catalogTitlePart2 || "PRODUCTOS"}</span>
          </div>
          <div class="cd-site"><span class="cd-site-line"></span>GRUPO-ORTIZ.COM</div>
        </header>

        <div class="cd-ficha-head">
          <div class="cd-ficha-copy">
            <h2 class="cd-h2 reveal" data-cd-path={`fichas.${idx}.nombre`}>{f.nombre}</h2>
            <p class="cd-p reveal" style="--d:.08s" data-cd-path={`fichas.${idx}.desc`}>{f.desc}</p>
          </div>
          <div class="cd-ficha-media reveal ${f.soon ? 'media-soon' : ''}">
            <div class="cd-ficha-media-inner" style={`transform: translate(${f.visual?.offsetX || 0}%, ${f.visual?.offsetY || 0}%) scale(${f.visual?.scale || 1}) rotate(${f.visual?.rotate || 0}deg); overflow: ${f.visual?.clip ? 'hidden' : 'visible'};`}>
              <img src={IMG(f.img)} alt={f.nombre} loading="lazy" decoding="async" style={`transform: scale(${f.visual?.zoom || 1});${(f.visual?.clipTop || f.visual?.clipBottom) ? ` clip-path: inset(${f.visual?.clipTop || 0}% 0 ${f.visual?.clipBottom || 0}% 0);` : ''}`} />
            </div>
            {f.soon && (
              <div class="cd-soon-overlay" aria-hidden="true">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span>{t.soon}</span>
              </div>
            )}
          </div>
        </div>

        {f.soon && (
          <div class="cd-soon-note reveal" style="--d:.12s">{t.soonNote}</div>
        )}

        {!f.soon && f.specs.length > 0 && f.single && (
        <div class="cd-table-wrap reveal" style="--d:.12s">
          <table class="cd-table cd-table-h">
            <thead>
              <tr>
                {f.specs.map((s, i) => (<th class={i % 2 === 0 ? 'th-o' : 'th-g'} data-cd-path={`fichas.${idx}.specs.${i}.c`}>{s.c}</th>))}
              </tr>
            </thead>
            <tbody>
              <tr>
                {f.specs.map((s) => (<td class="td-n">{s.min}{s.uni ? (' ' + s.uni) : ''}</td>))}
              </tr>
            </tbody>
          </table>
        </div>
        )}

        {!f.soon && f.specs.length > 0 && !f.single && (
        <div class="cd-table-wrap reveal" style="--d:.12s">
          <table class="cd-table">
            <thead>
              <tr>
                <th class="th-o" rowspan="2">{t.characteristics}</th>
                <th class="th-g" colspan="2">{t.measurement}</th>
                {f.cols.tol && <th class="th-o" rowspan="2">{t.tolerances}</th>}
                {f.cols.uni && <th class="th-g" rowspan="2">{t.unit}</th>}
                {f.cols.met && <th class="th-o" rowspan="2">{t.testMethod}</th>}
              </tr>
              <tr>
                <th class="th-g" style="font-size: 9px; padding-top: 2px; padding-bottom: 2px;">{t.min}</th>
                <th class="th-g" style="font-size: 9px; padding-top: 2px; padding-bottom: 2px;">{t.max}</th>
              </tr>
            </thead>
            <tbody>
              {f.specs.map((s, i) => (
                <tr class={s.hl ? 'cd-hl' : ''} style={`--d:${i * 0.04}s`}>
                  <td class="td-c" data-cd-path={`fichas.${idx}.specs.${i}.c`}>{s.c}</td>
                  <td class="td-n">{s.min}</td>
                  <td class="td-n">{s.max}</td>
                  {f.cols.tol && <td class="td-n">{s.tol}</td>}
                  {f.cols.uni && <td class="td-n">{s.uni}</td>}
                  {f.cols.met && <td class="td-n" style="font-size:11px;">{s.met}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        )}

        {!f.soon && f.colorTable && Array.isArray(f.colorTable.rows) && f.colorTable.rows.length > 0 && (
        <div class="cd-ctable-wrap reveal" style="--d:.12s">
          <table class="cd-ctable">
            <thead>
              <tr>
                <th class="th-o">{ctl.color}</th>
                <th class="th-g">{ctl.in}</th>
                <th class="th-g">{ctl.yd}</th>
              </tr>
            </thead>
            <tbody>
              {f.colorTable.rows.map((r, i) => (
                <tr style={`--d:${i * 0.04}s`}>
                  <td class="ct-color">{T(r.color)}</td>
                  <td class="ct-m">{r.in}</td>
                  <td class="ct-m">{r.yd}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        )}

        {!f.soon && f.matrix && Array.isArray(f.matrix.rows) && f.matrix.rows.length > 0 && (
        <div class="cd-mtable-wrap reveal" style="--d:.12s">
          {f.matrix.title && <div class="cd-mtable-title">{T(f.matrix.title)}</div>}
          <div class="cd-mtable-scroll">
            <table class="cd-mtable">
              {Array.isArray(f.matrix.headers) && f.matrix.headers.length > 0 && (
                <thead>
                  <tr>{f.matrix.headers.map((h, hi) => (<th class={hi === 0 ? 'th-o' : 'th-g'}>{T(h)}</th>))}</tr>
                </thead>
              )}
              <tbody>
                {f.matrix.rows.map((r, i) => (
                  <tr style={`--d:${i * 0.04}s`}>
                    <td class="mt-label">{T(r.label)}</td>
                    {(r.cells || []).map((cell) => (<td class="mt-cell">{cell}</td>))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {f.matrix.note && <p class="cd-mtable-note">{T(f.matrix.note)}</p>}
        </div>
        )}
      </section>
    ))}

    </div><!-- /cd-deck -->

    <!-- Hidden nav: keeps JS IDs alive, not visible -->
    <div aria-hidden="true" style="display:none">
      <button id="cdPrev" type="button"></button>
      <span id="cdCur"></span><span id="cdTot"></span>
      <button id="cdNext" type="button"></button>
    </div>

    <!-- Scroll hint: shown on first slide only -->
    <div class="cd-scroll-hint" id="cdScrollHint">
      <div class="cd-scroll-mouse">
        <div class="cd-scroll-wheel"></div>
      </div>
      <span>Deslizar para ver más</span>
    </div>

    <!-- Navegación entre catálogos (admin) -->
    <div id="cdCatNav"></div>

    <!-- Navegación mobile (fixed bottom) -->
    {(() => {
      const cats = listCatalogsMeta();
      const catIdx = cats.findIndex(c => c.slug === slug);
      const prevCat = catIdx > 0 ? cats[catIdx - 1] : null;
      const nextCat = catIdx < cats.length - 1 ? cats[catIdx + 1] : null;
      return (
        <nav class="cd-mob-nav" aria-label="Navegación entre divisiones">
          {prevCat ? (
            <a href={`/${currentLang}/catalogo/${prevCat.slug}`} class="cd-mob-arrow" aria-label={`Anterior: ${prevCat.title}`}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </a>
          ) : <span class="cd-mob-arrow is-disabled"></span>}
          <span class="cd-mob-current">{meta.title}</span>
          {nextCat ? (
            <a href={`/${currentLang}/catalogo/${nextCat.slug}`} class="cd-mob-arrow" aria-label={`Siguiente: ${nextCat.title}`}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </a>
          ) : <span class="cd-mob-arrow is-disabled"></span>}
        </nav>
      );
    })()}

    <!-- Floating ¿Cómo funciona? button -->
    <button class="cd-how-fab cd-ed-h" id="cdHowBtn" type="button" aria-label="¿Cómo funciona?">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <span>¿Cómo funciona?</span>
    </button>
  </main>

  <!-- Overlay fullscreen descarga catálogo general (fuera de <main> para evitar stacking contexts) -->
  <div class="cd-gen-overlay" id="cdGenOverlay" style="display:none">
    <div class="cd-gen-card" id="cdGenProgress">
      <div class="cd-gen-mb" id="cdGenMb">0%</div>
      <div class="cd-gen-title">CATÁLOGO GENERAL</div>
      <div class="cd-gen-sub">Grupo Ortiz · Todas las divisiones</div>
      <div class="cd-gen-bar-wrap">
        <div class="cd-gen-bar" id="cdGenBar"></div>
      </div>
      <div class="cd-gen-txt" id="cdGenTxt">GENERANDO</div>
    </div>
    <div class="cd-gen-card cd-gen-err-card" id="cdGenErrCard" style="display:none">
      <div class="cd-gen-err-icon">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <div class="cd-gen-err-title">No se pudo generar</div>
      <div class="cd-gen-err-msg" id="cdGenErrMsg">Intenta de nuevo en un momento</div>
      <button class="cd-gen-err-retry" id="cdGenRetry">Reintentar</button>
    </div>
  </div>

  <Footer currentLang={currentLang} />

  <style>
    .cd {
      --o: #fb670b;
      --gray: #9a9a9c;
      --hgray: #6f6f72;
      
      /* Default Light Theme */
      --bg: #f5f5f7;
      --bg2: #ffffff;
      --text: #1b1b1c;
      --text-muted: #6f6f72;
      --line: rgba(0,0,0,.1);
      --card-bg: #ffffff;
      --table-th-g: #333;
      --table-border: #ddd;
      --table-row-alt: #fcfcfc;
      --table-text: #1d1d1f;

      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, "Helvetica Neue", Arial, sans-serif;
      overflow-x: hidden;
      position: relative;
      transition: background .4s, color .4s;
    }

    /* Dark Theme */
    :global(.dark) .cd {
      --bg: #1b1b1c;
      --bg2: #242425;
      --text: #ffffff;
      --text-muted: #c9c9cc;
      --line: rgba(255,255,255,.14);
      --card-bg: #1b1b1c;
      --table-th-g: #333;
      --table-border: #444;
      --table-row-alt: #232324;
      --table-text: #ffffff;
    }

    .cd * { box-sizing: border-box; }

    /* ── Barra / logo Product Catalog ── */
    .cd-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 12px clamp(16px, 4vw, 48px);
      pointer-events: none;
    }
    .cd-logo { display: flex; flex-direction: column; line-height: .8; font-family: "Morganite", sans-serif; font-weight: 800; }
    .cd-logo-1 { font-size: 22px; letter-spacing: .04em; color: var(--text); }
    .cd-logo-2 { font-size: 30px; letter-spacing: .04em; color: var(--o); font-style: italic; display: flex; align-items: center; gap: 4px; }
    .cd-chevs { font-style: normal; color: var(--o); }
    .cd-site { display: flex; align-items: center; gap: 12px; font-size: 11px; letter-spacing: .14em; color: var(--text-muted); }
    .cd-site-line { width: 44px; height: 2px; background: var(--o); display: inline-block; }

    /* Header repetido en cada seccion de producto (como las laminas) */
    /* Todos los headers de seccion bajan para librar el navbar del sitio
       (en modo deck cada slide arranca arriba, igual que la portada) */
    .cd-bar-sec {
      position: absolute; top: clamp(78px, 9vh, 104px); left: 0; right: 0; z-index: 6;
      padding: 0 clamp(20px,6vw,90px);
      background: none;
    }

    /* ── HERO ── */
    .cd-hero {
      position: relative; min-height: 100svh;
      padding: clamp(190px,23vh,250px) clamp(20px,6vw,90px) 60px;
      display: grid; grid-template-columns: 1.5fr 1fr;
      grid-template-areas: "title prods" "copy prods";
      align-content: center; gap: 0 40px;
      background: var(--bg);
      overflow: hidden;
    }
    :global(.dark) .cd-hero {
      background: linear-gradient(115deg, #161617 0%, #232324 60%, #1a1a1b 100%);
    }
    .cd-hero-media {
      position: absolute; right: -2%; top: 50%; transform: translateY(-50%);
      width: min(55vw, 800px); pointer-events: none; user-select: none; z-index: 1;
      height: 60vh; display: flex; align-items: center; justify-content: flex-end;
      overflow: visible; /* Elimina el marco/corte de la imagen */
      contain: layout; /* Agrandar la imagen no altera el alto del slide ni la animacion (el sangrado visual se conserva) */
    }
    .cd-hero-media img { width: 100%; filter: drop-shadow(0 40px 60px rgba(0,0,0,.4)); }
    :global(.dark) .cd-hero-media img { filter: drop-shadow(0 40px 60px rgba(0,0,0,.7)); }

    .cd-hero-inner { grid-area: title; position: relative; z-index: 2; max-width: 760px; }
    .cd-hero-title {
      font-family: "Morganite", sans-serif; font-weight: 800;
      font-size: clamp(70px, 13vw, 180px); line-height: .8; letter-spacing: .01em;
      margin: 0; display: flex; flex-wrap: wrap; gap: 0 .22em;
    }
    .cd-orange { color: var(--o); }
    .cd-gray { color: var(--gray); }
    .cd-hero-div {
      font-family: "Morganite", sans-serif; font-weight: 800; font-size: clamp(28px,4vw,46px);
      color: var(--text); letter-spacing: .04em; margin: 2px 0 22px;
    }
    .cd-hero-copy { grid-area: copy; position: relative; z-index: 2; max-width: 640px; }
    .cd-hero-copy p {
      font-size: clamp(13px,1.45vw,16px); line-height: 1.55; color: var(--text-muted); margin: 0 0 10px;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .cd-hero-copy b { color: var(--text); }
    .cd-bio-t { color: var(--o) !important; font-weight: 700; margin-top: 6px !important; }

    /* ── Hero Buttons ── */
    .cd-hero-actions {
      margin-top: 26px;
      display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    }
    .cd-dl, .cd-btn-hero {
      display: inline-flex; align-items: center; gap: 10px; width: fit-content;
      background: var(--o); color: #fff; text-decoration: none;
      padding: 14px 26px; border-radius: 999px; font-size: 14px; font-weight: 700; letter-spacing: .02em;
      box-shadow: 0 10px 30px rgba(251,103,11,.28); transition: transform .25s, box-shadow .25s, opacity .25s;
      cursor: pointer; border: none;
    }
    .cd-btn-hero {
      background: transparent; border: 1px solid var(--line);
      color: var(--text);
      box-shadow: none;
    }
    .cd-dl:hover, .cd-btn-hero:hover { transform: translateY(-2px); }
    .cd-dl:hover { box-shadow: 0 14px 36px rgba(251,103,11,.4); }
    .cd-btn-hero:hover { background: rgba(0,0,0,.05); border-color: var(--o); }
    :global(.dark) .cd-btn-hero:hover { background: rgba(255,255,255,.05); }

    .cd-dl[aria-busy="true"] { opacity: .75; pointer-events: none; }
    .cd-dl svg { flex: none; }

    /* ── Botón Catálogo General ── */
    .cd-dl-general { background: #1b1b1c; box-shadow: 0 10px 30px rgba(0,0,0,.25); }
    :global(.dark) .cd-dl-general { background: #fff; color: #1b1b1c; box-shadow: 0 10px 30px rgba(255,255,255,.15); }
    .cd-dl-general:hover { background: #333; box-shadow: 0 14px 36px rgba(0,0,0,.4); }
    :global(.dark) .cd-dl-general:hover { background: #e5e5e5; }

    /* ── Overlay fullscreen descarga ── */
    .cd-gen-overlay {
      position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      z-index: 999; /* debajo del navbar (1000) */
      background: #f5f5f7;
      display: flex; align-items: center; justify-content: center;
      font-family: -apple-system, "Helvetica Neue", Arial, sans-serif;
      margin: 0; padding: 0;
      padding-top: 80px; /* espacio para el navbar arriba */
    }
    :global(.dark) .cd-gen-overlay { background: #1b1b1c; }
    .cd-gen-card {
      text-align: center; max-width: 480px; width: 90%;
      display: flex; flex-direction: column; align-items: center; gap: 10px;
    }
    .cd-gen-title {
      font-family: "Morganite", sans-serif; font-weight: 800;
      font-size: clamp(42px, 7vw, 72px); line-height: .9;
      color: #fb670b; letter-spacing: .02em; text-transform: uppercase;
    }
    .cd-gen-sub {
      font-size: 13px; font-weight: 600; color: #6f6f72;
      letter-spacing: .08em; text-transform: uppercase;
    }
    :global(.dark) .cd-gen-sub { color: #c9c9cc; }
    .cd-gen-mb {
      font-family: "Morganite", sans-serif; font-weight: 800;
      font-size: clamp(72px, 14vw, 130px); letter-spacing: .02em;
      color: #fb670b; line-height: 1;
    }
    .cd-gen-bar-wrap {
      width: 100%; height: 6px; background: rgba(0,0,0,.10);
      border-radius: 3px; overflow: hidden;
    }
    :global(.dark) .cd-gen-bar-wrap { background: rgba(255,255,255,.1); }
    .cd-gen-bar {
      height: 100%; border-radius: 3px; background: #1b1b1c;
      width: 0%; transition: width .35s cubic-bezier(.25,.46,.45,.94);
    }
    :global(.dark) .cd-gen-bar { background: #ffffff; }
    .cd-gen-txt {
      font-family: "Morganite", sans-serif; font-weight: 800;
      font-size: 18px; letter-spacing: .12em;
      text-transform: uppercase; color: #6f6f72; line-height: 1;
    }
    :global(.dark) .cd-gen-txt { color: #c9c9cc; }

    .cd-gen-err-card {
      gap: 8px;
    }
    .cd-gen-err-icon {
      color: #6f6f72; margin-bottom: 4px;
    }
    :global(.dark) .cd-gen-err-icon { color: #c9c9cc; }
    .cd-gen-err-title {
      font-family: "Morganite", sans-serif; font-weight: 800;
      font-size: 32px; letter-spacing: .04em; color: #1b1b1c;
      text-transform: uppercase;
    }
    :global(.dark) .cd-gen-err-title { color: #f5f5f7; }
    .cd-gen-err-msg {
      font-size: 13px; color: #6f6f72; letter-spacing: .02em;
    }
    :global(.dark) .cd-gen-err-msg { color: #c9c9cc; }
    .cd-gen-err-retry {
      margin-top: 8px; padding: 9px 24px;
      background: #1b1b1c; color: #fff;
      border: none; border-radius: 20px;
      font-size: 13px; font-weight: 600; letter-spacing: .06em;
      cursor: pointer; transition: opacity .2s;
    }
    :global(.dark) .cd-gen-err-retry { background: #fff; color: #1b1b1c; }
    .cd-gen-err-retry:hover { opacity: .75; }

    .cd-hero-prods { grid-area: prods; position: relative; z-index: 2; align-self: end; justify-self: end; text-align: right; padding-bottom: 60px; }
    /* Año de actualización del catálogo — abajo a la derecha */
    .cd-year { position: absolute; right: clamp(20px, 6vw, 90px); bottom: 18px; z-index: 3; color: var(--o); font-family: "Morganite", sans-serif; font-weight: 800; font-size: clamp(46px, 6vw, 72px); line-height: 1; letter-spacing: .03em; pointer-events: none; }
    .cd-prods-t { color: var(--gray); font-size: 14px; }
    .cd-hero-prods ul { list-style: none; margin: 8px 0 0; padding: 0; }
    .cd-hero-prods li { font-size: 14px; color: var(--text-muted); padding: 3px 0; }

    /* >3 productos: imagen arriba, lista horizontal al pie (full width) */
    .cd-hero-prodrow { grid-template-areas: "title ." "copy ." "prods prods"; }
    .cd-hero-prodrow .cd-hero-media { top: 40%; }
    .cd-hero-prodrow .cd-hero-prods {
      justify-self: stretch; align-self: end; text-align: left; padding-bottom: 0;
      margin-top: 34px; display: flex; align-items: baseline; gap: 8px 18px; flex-wrap: wrap;
    }
    .cd-hero-prodrow .cd-hero-prods ul { display: flex; flex-wrap: wrap; gap: 4px 22px; margin: 0; }
    .cd-hero-prodrow .cd-hero-prods li { padding: 0; }

    /* ── Tipos compartidos ── */
    .cd-h2 {
      font-family: "Morganite", sans-serif; font-weight: 800;
      font-size: clamp(40px, 6.5vw, 84px); line-height: .9; letter-spacing: .01em;
      margin: 6px 0 16px; color: var(--text);
    }
    .cd-p { font-size: clamp(13px, 1.45vw, 16px); line-height: 1.6; color: var(--text-muted); margin: 0 0 14px; max-width: 64ch; }
    .cd-p b { color: var(--text); }

    /* ── FICHAS ── */
    .cd-ficha { position: relative; padding: clamp(140px, 13vw, 180px) clamp(20px, 6vw, 90px) clamp(56px, 8vw, 100px); border-top: 1px solid var(--line); overflow: hidden; }
    .cd-ficha-bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background: radial-gradient(70% 90% at 85% 30%, rgba(251,103,11,.06), transparent 60%);
    }
    .cd-ficha.is-left .cd-ficha-bg { background: radial-gradient(70% 90% at 15% 30%, rgba(251,103,11,.06), transparent 60%); }
    .cd-ficha-head { position: relative; z-index: 1; display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(14px, 4vw, 60px); align-items: center; margin-bottom: 32px; }
    .cd-ficha-media {
      position: relative; display: flex; align-items: center; justify-content: flex-end; z-index: 1;
      height: clamp(300px, 40vh, 420px); overflow: visible; /* Sin marcos que corten la imagen */
      contain: layout; /* Agrandar la imagen no altera el alto del slide ni la animacion (el sangrado visual se conserva) */
    }
    .cd-ficha-media-inner {
      position: relative; display: flex; align-items: center; justify-content: flex-end; width: 100%; transition: transform 0.1s ease;
    }
    .cd-ficha-media img { width: 100%; max-width: 580px; max-height: 420px; object-fit: contain; filter: drop-shadow(0 30px 60px rgba(0,0,0,.25)); }
    :global(.dark) .cd-ficha-media img { filter: drop-shadow(0 30px 60px rgba(0,0,0,.65)); }

    .cd-ficha-copy { position: relative; z-index: 2; }
    .cd-ficha-copy .cd-h2 { margin-top: 0; font-size: clamp(50px, 8vw, 110px); }

    /* ── Tabla tecnica (espejo de laminas) ── */
    .cd-table-wrap { position: relative; z-index: 4; background: var(--bg); border-radius: 10px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .cd-table { width: 100%; border-collapse: collapse; min-width: 800px; font-size: 14px; }
    .cd-table .td-c { text-align: left; color: var(--table-text); font-weight: 400; white-space: nowrap; text-transform: capitalize; }
    .cd-table .td-n { font-variant-numeric: tabular-nums; color: var(--table-text); font-weight: 400; white-space: nowrap; }
    .cd-table th, .cd-table td { padding: 10px 12px; text-align: center; border: 1px solid var(--table-border); }
    .cd-table thead th { font-weight: 800; letter-spacing: .03em; color: #fff; vertical-align: middle; font-size: 15px; }
    .th-o { background: var(--o); }
    .th-g { background: var(--table-th-g); }
    .cd-table tbody td { background: var(--bg2); color: var(--table-text); }
    .cd-table tbody tr:nth-child(even) td { background: var(--table-row-alt); }
    .cd-hl td { background: rgba(251,103,11,0.04) !important; }
    .cd-hl .td-c { color: var(--o); font-weight: 600; }
    .cd-hl .td-n { color: var(--table-text); }


    /* ── Producto "Proximamente" (ej Naturizable: Vaso, Contenedor) ── */
    .cd-ficha.is-soon .cd-ficha-media,
    .cd-ficha.is-soon .cd-ficha-media-inner { justify-content: center; }
    .cd-ficha.is-soon .cd-ficha-media-inner img { filter: blur(5px) grayscale(0.2); }
    .cd-soon-overlay {
      position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; z-index: 3; pointer-events: none;
      background: rgba(0,0,0,0.35); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-radius: 12px;
    }
    .cd-soon-overlay svg { color: #fff; }
    .cd-soon-overlay span {
      font-family: "Morganite", sans-serif; font-weight: 800; font-size: clamp(24px, 4vw, 36px);
      color: #fff; letter-spacing: .1em; text-transform: uppercase;
    }
    .cd-soon-note { position: relative; z-index: 1; color: var(--o); font-weight: 700; font-size: 14px; margin-top: -10px; margin-bottom: 10px; }

    /* ── Tabla horizontal: cada caracteristica es columna, una fila de valores (ej Bolsas) ── */
    .cd-table-h { min-width: 0; table-layout: fixed; }
    .cd-table-h thead th { font-size: 12px; padding: 10px 8px; }
    .cd-table-h .td-n { white-space: normal; line-height: 1.35; padding: 14px 8px; font-weight: 600; }

    /* ── Tabla de medidas por color (Color | Pulgadas | Yardas) ── */
    .cd-ctable-wrap { position: relative; z-index: 1; overflow-x: auto; -webkit-overflow-scrolling: touch; margin-top: 14px; }
    .cd-ctable { width: 100%; border-collapse: collapse; font-size: 13px; }
    .cd-ctable th, .cd-ctable td { padding: 9px 12px; border: 1px solid var(--table-border); text-align: left; vertical-align: top; }
    .cd-ctable thead th { font-weight: 800; letter-spacing: .03em; color: #fff; font-size: 13px; }
    .cd-ctable .th-o { background: var(--o); }
    .cd-ctable .th-g { background: var(--table-th-g); }
    .cd-ctable tbody td { background: var(--bg2); color: var(--table-text); }
    .cd-ctable tbody tr:nth-child(even) td { background: var(--table-row-alt); }
    .cd-ctable .ct-color { font-weight: 600; white-space: nowrap; color: var(--o); width: 1%; }
    .cd-ctable .ct-m { font-variant-numeric: tabular-nums; line-height: 1.5; white-space: normal; }
    .cd[data-deck-on] .cd-ctable-wrap { max-height: 42vh; overflow-y: auto; }

    /* ── Tabla matriz (atributo x medida): ej Esquinero ESPECIFICACIONES ── */
    .cd-mtable-wrap { position: relative; z-index: 1; margin-top: 14px; }
    .cd-mtable-title { background: var(--o); color: #fff; font-weight: 800; text-align: center; padding: 9px; letter-spacing: .06em; font-size: 13px; }
    .cd-mtable-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .cd-mtable { width: 100%; border-collapse: collapse; font-size: 12px; }
    .cd-mtable th, .cd-mtable td { border: 1px solid var(--table-border); padding: 8px 10px; text-align: center; vertical-align: middle; }
    .cd-mtable thead th { color: #fff; font-weight: 800; }
    .cd-mtable .th-o { background: var(--o); }
    .cd-mtable .th-g { background: var(--table-th-g); }
    .cd-mtable .mt-label { background: var(--o); color: #fff; font-weight: 800; text-align: left; white-space: nowrap; }
    .cd-mtable .mt-cell { background: var(--bg2); color: var(--table-text); white-space: pre-line; line-height: 1.45; font-variant-numeric: tabular-nums; }
    .cd-mtable tbody tr:nth-child(even) .mt-cell { background: var(--table-row-alt); }
    .cd-mtable-note { margin-top: 8px; font-size: 12px; color: var(--text-muted); font-style: italic; }
    .cd[data-deck-on] .cd-mtable-scroll { max-height: 38vh; overflow-y: auto; }

    /* ── Reveal ── */
    .reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1); transition-delay: var(--d, 0s); }
    .reveal.in { opacity: 1; transform: none; }

    /* ── FAB ¿Cómo funciona? ── */
    .cd-how-fab { position:fixed; bottom:26px; left:20px; z-index:9001; display:inline-flex; align-items:center; gap:8px; padding:12px 20px; background:var(--o); border:none; border-radius:999px; color:#fff; font-size:12px; font-weight:800; cursor:pointer; font-family:inherit; letter-spacing:.4px; box-shadow:0 6px 24px rgba(251,103,11,.45); transition:box-shadow .22s,transform .22s; }
    .cd-how-fab:hover { box-shadow:0 10px 32px rgba(251,103,11,.65); transform:translateY(-2px); }
    .cd[data-cd-pdf] .cd-how-fab, :global(html[data-cd-shot]) .cd-how-fab { display:none !important; }
    /* ── Tutorial highlight animation ── */
    @keyframes cdTutPulse {
      0%,100% { box-shadow: 0 0 0 3px #FB670B, 0 0 0 8px rgba(251,103,11,.3), 0 0 24px rgba(251,103,11,.5); }
      50%      { box-shadow: 0 0 0 3px #FB670B, 0 0 0 14px rgba(251,103,11,.12), 0 0 44px rgba(251,103,11,.75); }
    }
    /* z-index layering: overlay=100000, highlight=100001, card=100002 */
    .cd-tut-hl { position:relative !important; z-index:100001 !important; animation: cdTutPulse 1.15s ease-in-out infinite; outline:none !important; }

    /* Guías de seguridad imaginarias (solo en edición) */
    .cd-ed-guides { position: fixed; inset: 40px 60px; border: 1px dashed rgba(251,103,11,0.25); pointer-events: none; z-index: 9997; display: none; opacity: 0; transition: opacity .4s; }
    .cd[data-cd-editing] .cd-ed-guides { display: block; opacity: 1; }
    .cd[data-cd-editing] { overflow: hidden !important; height: 100vh !important; position: fixed; width: 100%; }

    /* Ocultar elementos de edicion en PDF/Captura */
    :global(html[data-cd-shot]) .cd-ed-h, :global(html[data-cd-shot]) #cdEdBtn,
    .cd[data-cd-pdf] .cd-ed-h, .cd[data-cd-pdf] #cdEdBtn { display: none !important; }
    .cd[data-cd-pdf] [data-cd-edit] { outline: none !important; background: none !important; }
    .cd-hero-prods li { opacity: 0; transform: translateY(12px); transition: opacity .5s ease, transform .5s ease; transition-delay: var(--d, 0s); }
    .cd-hero-prods.in li { opacity: 1; transform: none; }
    .cd-table tbody tr,
    .cd-ctable tbody tr,
    .cd-mtable tbody tr { opacity: 1; transform: none; transition: none; }
    .cd-table-wrap,
    .cd-ctable-wrap,
    .cd-mtable-wrap { opacity: 1 !important; transform: none !important; transition: none !important; }

    @media (prefers-reduced-motion: reduce) {
      .reveal, .cd-hero-prods li, .cd-table tbody tr { transition: none; opacity: 1; transform: none; }
    }

    /* ── Modo diapositivas (deck) — solo desktop ── */
    .cd-deck { position: relative; }
    @media (max-width: 900px) {
      .cd[data-deck-on] .cd-deck { height: auto !important; overflow: visible !important; }
      .cd[data-deck-on] .cd-slide { position: relative !important; opacity: 1 !important; visibility: visible !important; transform: none !important; }
    }
    @media (min-width: 901px) {
      .cd[data-deck-on] .cd-deck { height: 100svh; overflow: hidden; }
      .cd[data-deck-on] .cd-slide {
        position: absolute; inset: 0; min-height: 100svh;
        opacity: 0; visibility: hidden; pointer-events: none;
        transform: translateY(46px);
        transition: opacity .55s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1), visibility 0s linear .7s;
        overflow: hidden; /* Evita saltos de scroll y la 'bajada' al editar imagenes gigantes */
      }
      .cd[data-deck-on] .cd-slide.is-active {
        opacity: 1; visibility: visible; pointer-events: auto; transform: none; z-index: 2;
        transition: opacity .6s cubic-bezier(.22,1,.36,1) .05s, transform .7s cubic-bezier(.22,1,.36,1) .05s;
      }
      .cd[data-deck-on] .cd-slide.is-exit-up { transform: translateY(-46px); }
      /* la ficha en deck centra su contenido verticalmente */
      .cd[data-deck-on] .cd-ficha { display: flex; flex-direction: column; justify-content: center; }
    }

    /* ── Scroll hint ── */
    .cd-scroll-hint {
      position: fixed; bottom: 26px; left: 50%; transform: translateX(-50%);
