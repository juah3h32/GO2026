        bn.onmouseenter=function(){bn.style.opacity='.85';};
        bn.onmouseleave=function(){bn.style.opacity='1';};
        bn.onclick=function(e){e.stopPropagation();if(isLast){s.leave();close();}else{s.leave();cur++;render();}};
        foot.appendChild(bn);
        card.appendChild(foot);

