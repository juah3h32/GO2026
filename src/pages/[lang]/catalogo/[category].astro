        card.innerHTML = '<div style="text-align:center;margin-bottom:26px;font-family:' + SANS + ';"><div style="width:56px;height:56px;background:' + cInp + ';border:1px solid ' + cBorder + ';border-radius:16px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:14px;box-shadow:0 0 24px rgba(251,103,11,.25);">' + robotSvg + '</div><h1 style="color:' + cText + ';font-size:21px;font-weight:800;margin:0;letter-spacing:-.3px;text-transform:none;font-family:' + SANS + ';line-height:1.2;">Editar catalogo</h1><p style="color:' + cMuted + ';font-size:13px;margin:6px 0 0;font-family:' + SANS + ';">Ingresa con tu contrasena</p></div>';
