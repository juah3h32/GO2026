      function edToggle(on) {
        editMode = on;
        if (on) {
          if (!deckOn) { alert('El editor visual funciona en escritorio (vista diapositivas).'); editMode = false; return; }
          if (!edBar) edBuildBar();
          edTextStyle();
          main.setAttribute('data-cd-editing', '');
          edBar.style.display = 'flex';
          if (edBtn) edBtn.style.display = 'none';
          edBind(); edBindText(); edSync(); edBarMode('none');
          document.addEventListener('mousedown', edDocDown);
          document.addEventListener('keydown', edKeyUndo, true);
        } else {
          if (edBar) edBar.style.display = 'none';
          if (edBtn) edBtn.style.display = 'flex';
          main.removeAttribute('data-cd-editing');
          edDeselect(); edUnbind(); edUnbindText();
