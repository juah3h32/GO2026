              edSaveThen(function () {
                if (edFields.msg) { edFields.msg.style.color = '#10B981'; edFields.msg.textContent = 'Imagen actualizada (' + donde + ')'; }
                setTimeout(function () { if (edFields.msg) { edFields.msg.style.color = '#9CA3AF'; edFields.msg.textContent = ''; } }, 2600);
              });
            })
            .catch(function (e) { if (edFields.msg) { edFields.msg.style.color = '#f87171'; edFields.msg.textContent = e.message; } });
        };
        inp.click();
      }

