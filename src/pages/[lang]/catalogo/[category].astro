      zh: { s1:'已选', sp:'已选', hi:'您好！我想询价以下产品（', ask:'请问能提供详细信息和报价吗？' },
      ar: { s1:'محدد', sp:'محددة', hi:'مرحباً! أرغب في الاستفسار عن أسعار المنتجات التالية من ', ask:'هل يمكنكم تزويدي بمزيد من المعلومات والأسعار؟' }
    }[_lang] || { s1:'seleccionado', sp:'seleccionados', hi:'Hola! Me interesa cotizar los siguientes productos de ', ask:'¿Podrían proporcionarme más información y precios?' };

    function getEls() {
      return {
        fab: document.getElementById('catSelFab'),
        count: document.getElementById('catSelCount'),
        lbl: document.getElementById('catSelLbl'),
        cta: document.getElementById('catSelCta'),
        deck: document.getElementById('cdDeck'),
      };
    }

    function updateFab() {
      var e = getEls();
      var n = selectedNames.size;
      if (e.count) e.count.textContent = n;
      if (e.lbl) e.lbl.textContent = n === 1 ? _t.s1 : _t.sp;
      if (e.fab) {
        if (n > 0) e.fab.classList.add('cat-fab-visible');
        else e.fab.classList.remove('cat-fab-visible');
      }
    }

    function buildMsg() {
      var div = document.querySelector('.cd[data-division]')?.dataset.division || 'productos';
      var names = Array.from(selectedNames);
      var msg = _t.hi + div + ':\n\n';
      names.forEach(function(n, i) { msg += (i + 1) + '. *' + n + '*\n'; });
      msg += '\n' + _t.ask;
      return encodeURIComponent(msg);
    }

    function toggleFicha(ficha, chip, name) {
      if (selectedNames.has(name)) {
        selectedNames.delete(name);
        ficha.classList.remove('cd-selected');
        if (chip) chip.classList.remove('is-selected');
      } else {
        selectedNames.add(name);
        ficha.classList.add('cd-selected');
        if (chip) chip.classList.add('is-selected');
      }
      updateFab();
      if (selectedNames.size === 0) deactivateMultiMode();
    }

    function activateMultiMode() {
      if (isMultiMode) return;
      isMultiMode = true;
      var deck = document.getElementById('cdDeck');
      if (deck) deck.classList.add('cd-multimode');
    }

    function deactivateMultiMode() {
      isMultiMode = false;
      var deck = document.getElementById('cdDeck');
      if (deck) deck.classList.remove('cd-multimode');
    }

    function bindFichas() {
      document.querySelectorAll('.cd-ficha[data-ficha-name]').forEach(function(ficha) {
        if (ficha.__catSelBound) return;
        ficha.__catSelBound = true;

        var name = ficha.dataset.fichaName;
        var chip = ficha.querySelector('.cd-sel-chip');

        // chip click always toggles
        if (chip) {
          chip.addEventListener('click', function(e) {
            e.stopPropagation();
            activateMultiMode();
            toggleFicha(ficha, chip, name);
          });
        }

        // mouse long press on ficha body
        var mouseTimer = null, didMouseLong = false;
        ficha.addEventListener('mousedown', function(e) {
          if (e.button !== 0 || e.target.closest('.cd-sel-chip')) return;
          didMouseLong = false;
          mouseTimer = setTimeout(function() {
            didMouseLong = true;
            activateMultiMode();
            toggleFicha(ficha, chip, name);
          }, 450);
        });
        ficha.addEventListener('mouseup', function() { clearTimeout(mouseTimer); });
        ficha.addEventListener('mouseleave', function() { clearTimeout(mouseTimer); });

        // click: en multi-mode → toggle directo; fuera → ignorar (long press activa el modo)
        ficha.addEventListener('click', function(e) {
          if (e.target.closest('.cd-sel-chip')) return;
          if (didMouseLong) { didMouseLong = false; return; }
          if (isMultiMode) {
            toggleFicha(ficha, chip, name);
          }
        });
      });
    }

    function bindCta() {
      var cta = document.getElementById('catSelCta');
      if (!cta || cta.__catSelCtaBound) return;
      cta.__catSelCtaBound = true;
      cta.addEventListener('click', function() {
        window.open('https://wa.me/' + WA + '?text=' + buildMsg(), '_blank');
      });
    }

    function init() {
      bindFichas();
      bindCta();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:after-swap', function() {
      selectedNames.clear();
      isMultiMode = false;
      var deck = document.getElementById('cdDeck');
      if (deck) deck.classList.remove('cd-multimode');
      init();
    });
  })();
  </script>

  <script is:inline define:vars={{ isStretch: slug === 'digital-stretch-film' }}>
  (function() {
    var STORAGE_KEY = 'go-divpick-seen';
    var COUNTDOWN   = 20;

    function initDivPick() {
      var overlay      = document.getElementById('cdDivPickOverlay');
      var closeBtn     = document.getElementById('cdDivPickClose');
      var countEl      = document.getElementById('cdDivPickCount');
      var bar          = document.getElementById('cdDivPickBar');
      var progressWrap = document.getElementById('cdDivPickProgressWrap');
      var flap         = document.getElementById('cdDivPickFlap');
      if (!overlay || !flap) return;

      var timer = null;
      var remaining = COUNTDOWN;

      function markSeen() { try { sessionStorage.setItem(STORAGE_KEY, '1'); } catch(e) {} }
      function alreadySeen() { try { return !!sessionStorage.getItem(STORAGE_KEY); } catch(e) { return false; } }
      function showFlap() { flap.classList.add('is-visible'); }
      function hideFlap() { flap.classList.remove('is-visible'); }

      var hdr = document.querySelector('.montfort-header');

      function navTextWhite() {
        if (!hdr) return;
        hdr.style.setProperty('--text-main', '#ffffff');
        hdr.dataset.divpick = '1';
      }

      function navRestore() {
        if (!hdr) return;
        hdr.style.removeProperty('--text-main');
        delete hdr.dataset.divpick;
      }

      function open(withCountdown) {
        overlay.classList.add('is-open');
        navTextWhite();
        hideFlap();
        if (withCountdown) {
          remaining = COUNTDOWN;
          if (countEl) { countEl.textContent = remaining; countEl.style.display = ''; }
          if (progressWrap) progressWrap.style.display = '';
          startCountdown();
        } else {
          if (countEl) countEl.style.display = 'none';
          if (progressWrap) progressWrap.style.display = 'none';
          if (timer) { clearInterval(timer); timer = null; }
        }
      }

      function close() {
        overlay.classList.remove('is-open');
        navRestore();
        if (timer) { clearInterval(timer); timer = null; }
        markSeen();
        showFlap();
      }

      function startCountdown() {
        if (bar) {
          bar.style.transition = 'none';
          bar.style.transform  = 'scaleX(1)';
          void bar.offsetWidth;
          bar.style.transition = 'transform ' + COUNTDOWN + 's linear';
          bar.style.transform  = 'scaleX(0)';
        }
        if (timer) clearInterval(timer);
        timer = setInterval(function() {
          remaining--;
          if (countEl) countEl.textContent = remaining;
          if (remaining <= 0) close();
        }, 1000);
      }

      // Stretch-film primera visita → auto-open con countdown
      // Resto de páginas o ya visto → pestaña visible de inmediato
      if (isStretch && !alreadySeen()) {
        setTimeout(function() { open(true); }, 200);
      } else {
        setTimeout(showFlap, 30);
      }

      overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });
      if (closeBtn) closeBtn.addEventListener('click', close);
      flap.addEventListener('click', function() { open(false); });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay.classList.contains('is-open')) close();
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initDivPick);
    else initDivPick();
    document.addEventListener('astro:page-load', initDivPick);
  })();
  </script>
