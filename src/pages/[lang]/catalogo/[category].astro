        var subEl = mk('div','font-size:13px;color:rgba(0,0,0,.42);margin-top:6px;line-height:1.4;font-weight:500;');
        subEl.textContent = s.subtitle;
        hero.appendChild(numEl); hero.appendChild(titleEl); hero.appendChild(subEl);
        card.appendChild(hero);

        /* separator */
        card.appendChild(mk('div','height:1px;background:rgba(0,0,0,.07);'));

        /* ═══ BODY ═══ */
        var body = mk('div','padding:18px 20px;height:190px;overflow:hidden;display:flex;flex-direction:column;justify-content:center;flex:none;');
        body.appendChild(s.demo());
        card.appendChild(body);

        /* separator */
        card.appendChild(mk('div','height:1px;background:rgba(0,0,0,.07);'));

        /* ═══ FOOTER ═══ */
        var foot = mk('div','padding:14px 20px 18px;display:flex;gap:8px;');
