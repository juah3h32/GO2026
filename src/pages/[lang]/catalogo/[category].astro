        topBar.appendChild(dotsWrap); topBar.appendChild(rightTop);
        card.appendChild(topBar);

        /* ═══ HERO ═══ */
        var hero = mk('div','padding:20px 24px 18px;');
        var numEl = mk('div','font-family:' + MG + ';font-weight:800;font-size:72px;line-height:.85;color:' + O + ';letter-spacing:-2px;');
        numEl.textContent = s.num;
        var titleEl = mk('div','font-family:' + MG + ';font-weight:800;font-size:32px;text-transform:uppercase;color:#111;line-height:1;margin-top:6px;letter-spacing:.3px;');
