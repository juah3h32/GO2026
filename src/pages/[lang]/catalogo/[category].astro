        var err = document.createElement('p'); err.style.cssText = 'color:#F87171;font-size:12px;margin:0;text-align:center;display:none;font-family:' + SANS + ';';
        var btn = document.createElement('button'); btn.type = 'submit'; btn.textContent = 'GO →';
        btn.style.cssText = 'background:#FB670B;border:none;border-radius:10px;padding:13px;color:#fff;font-size:16px;font-weight:800;cursor:pointer;letter-spacing:1px;width:100%;font-family:' + SANS + ';';
        var cancel = document.createElement('button'); cancel.type = 'button'; cancel.textContent = 'Cancelar';
        cancel.style.cssText = 'background:transparent;border:none;color:' + cMuted + ';font-size:13px;cursor:pointer;text-decoration:underline;padding:4px 0;margin-top:10px;display:block;width:100%;font-family:' + SANS + ';';
        form.appendChild(inp); form.appendChild(err); form.appendChild(btn);
        card.appendChild(form); card.appendChild(cancel); ov.appendChild(card); document.body.appendChild(ov);
        // Navbar blanco mientras el login esta abierto (sobre el fondo oscurecido no se ve en negro)
        var hdr = document.querySelector('.montfort-header');
        var hadBlack = hdr && hdr.classList.contains('force-black');
        if (hdr) { hdr.classList.add('force-white'); hdr.classList.remove('force-black'); }
        setTimeout(function () { inp.focus(); }, 50);
        function close() { ov.remove(); if (hdr) { hdr.classList.remove('force-white'); if (hadBlack) hdr.classList.add('force-black'); } }
        cancel.onclick = close;
        ov.addEventListener('mousedown', function (e) { if (e.target === ov) close(); });
        document.addEventListener('keydown', function esc(ev) { if (ev.key === 'Escape') { close(); document.removeEventListener('keydown', esc); } });
        form.onsubmit = function (e) {
          e.preventDefault(); var pw = inp.value.trim(); if (!pw) return;
          btn.textContent = '…'; btn.disabled = true; err.style.display = 'none';
          fetch('/api/auth', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ password: pw }) })
            .then(function (r) { return r.json().catch(function () { return {}; }); })
            .then(function (d) {
              if (d && d.ok) { close(); edInitAdmin(); }
              else { btn.textContent = 'GO →'; btn.disabled = false; err.textContent = (d && d.error) || 'Contrasena incorrecta'; err.style.display = 'block'; card.style.animation = 'cdshake .5s ease'; setTimeout(function () { card.style.animation = ''; }, 520); }
            })
            .catch(function () { btn.textContent = 'GO →'; btn.disabled = false; err.textContent = 'Error de conexion'; err.style.display = 'block'; });
        };
      }
      // Atajo: Ctrl/Cmd + Shift + E -> habilita edicion aqui mismo (sin pasar por el dashboard).
      document.addEventListener('keydown', function (e) {
        if (!((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'E' || e.key === 'e'))) return;
        e.preventDefault();
        if (edBtn || editMode) { edToggle(true); return; } // ya habilitado
        edShowLogin();
      });

      if (elPrev) elPrev.addEventListener('click', onPrev);
      if (elNext) elNext.addEventListener('click', onNext);
      window.addEventListener('wheel', onWheel, { passive: false });
      window.addEventListener('keydown', onKey);
      window.addEventListener('touchstart', onTS, { passive: true });
      window.addEventListener('touchend', onTE, { passive: true });

      var qp0 = new URLSearchParams(location.search);
      var isPdf = qp0.get('pdf') === '1';
      var mq = window.matchMedia('(min-width: 901px)');
      function apply() { if (mq.matches && slides.length) enableDeck(); else disableDeck(); }
      var onMQ = function () { apply(); };
      if (isPdf) {
        // Modo PDF: pagina estatica, sin deck, todo revelado, tema solicitado.
        if (qp0.get('theme') === 'dark') document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
        main.setAttribute('data-cd-pdf', '');
        disableDeck();
        main.querySelectorAll('.reveal').forEach(function (e) { e.classList.add('in'); });
        document.body.style.overflow = '';
      } else {
        apply();
        if (mq.addEventListener) mq.addEventListener('change', onMQ); else mq.addListener(onMQ);
      }

      // Modo captura para PDF fiel: deck visible, expone control de slide.
      if (qp0.get('shot') === '1') {
        if (qp0.get('theme') === 'dark') document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-cd-shot', '');
        window.__cdN = slides.length;
        window.__cdGo = function (i) { show(i); };
      }

      window.__cdCleanup = function () {
        if (elDl) elDl.removeEventListener('click', onDl);
        edEnd(); edDeselect(); edUnbind(); edUnbindText();
        if (main) main.removeAttribute('data-cd-editing');
        document.removeEventListener('mousedown', edDocDown);
        document.removeEventListener('keydown', edKeyUndo, true);
        if (edBar) { edBar.remove(); edBar = null; }
        if (edBtn) { edBtn.remove(); edBtn = null; }
        editMode = false;
        window.removeEventListener('wheel', onWheel);
        window.removeEventListener('keydown', onKey);
        window.removeEventListener('touchstart', onTS);
        window.removeEventListener('touchend', onTE);
        if (mq.removeEventListener) mq.removeEventListener('change', onMQ); else mq.removeListener(onMQ);
        if (io) { io.disconnect(); io = null; }
        document.body.style.overflow = '';
        window.__cdCleanup = null;
      };
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', cdInit);
    else cdInit();
    document.addEventListener('astro:page-load', cdInit);
    document.addEventListener('astro:after-swap', cdInit);
  </script>
</BaseLayout>
