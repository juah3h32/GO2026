          var bp = mk('button','flex:0 0 auto;padding:16px 20px;border-radius:12px;border:none;background:#EBEBEB;color:#333;cursor:pointer;transition:background .2s;font-family:' + MG + ';font-size:20px;font-weight:800;letter-spacing:.3px;white-space:nowrap;display:flex;align-items:center;gap:8px;');
