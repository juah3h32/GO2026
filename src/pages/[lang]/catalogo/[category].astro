              var txtDiv = btn ? btn.firstElementChild : null;
              if (btn && txtDiv) {
                /* desactiva transición para medir el ancho real expandido */
                var oldTransition = txtDiv.style.transition;
                txtDiv.style.transition = 'none';
                txtDiv.style.maxWidth = '180px';
                txtDiv.style.opacity = '1';
                btn.style.background = 'rgba(235,235,235,0.97)';
                btn.style.boxShadow = '0 0 0 3px rgba(251,103,11,.55),0 0 24px rgba(251,103,11,.35),0 8px 28px rgba(0,0,0,.3)';
                /* fuerza reflow sincrono con el boton ya expandido */
                btn.offsetHeight;
                var r = btn.getBoundingClientRect();
                /* restaura transición */
                txtDiv.style.transition = oldTransition;
                if (r.width) {
                  var sp = document.createElement('div');
                  sp.style.cssText = 'position:fixed;pointer-events:none;z-index:100002;box-sizing:border-box;border-radius:999px;animation:cdTutPulse 1.15s ease-in-out infinite;top:' + (r.top - 4) + 'px;left:' + (r.left - 4) + 'px;width:' + (r.width + 8) + 'px;height:' + (r.height + 8) + 'px;';
                  document.body.appendChild(sp); spots.push(sp);
                }
              }
            });
          },
          leave: function() {
            /* colapsar botones antes de restaurar z-index */
            var nav = document.getElementById('cdCatNav');
            if (nav) {
              Array.prototype.slice.call(nav.children).forEach(function(wrapper) {
                var btn = wrapper.querySelector('button');
                var txtDiv = btn ? btn.firstElementChild : null;
                if (btn && txtDiv) {
                  txtDiv.style.maxWidth = '0'; txtDiv.style.opacity = '0';
                  btn.style.background = 'transparent'; btn.style.boxShadow = 'none';
                }
              });
            }
            unhlContainers(); unhl();
          },
          demo: function () {
            var w = mk('div','display:flex;align-items:center;gap:12px;padding:14px;border-radius:14px;background:#F2F2F2;');
            function arr(svg) {
              var d = mk('div','width:40px;height:40px;flex-shrink:0;border-radius:50%;background:' + O + ';display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(251,103,11,.38);');
              d.innerHTML = svg; return d;
            }
            var lA = arr('<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>');
            var rA = arr('<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>');
            var info = mk('div','flex:1;text-align:center;');
            var iLbl = mk('div','font-family:' + MG + ';font-weight:800;font-size:12px;letter-spacing:3px;text-transform:uppercase;color:' + O + ';margin-bottom:3px;');
            iLbl.textContent = 'División actual';
            var iTitle = mk('div','font-family:' + MG + ';font-weight:800;font-size:24px;text-transform:uppercase;letter-spacing:.5px;color:#111;line-height:1;');
            iTitle.textContent = cats[ci] ? cats[ci].title : 'STRETCH FILM';
            var iCount = mk('div','font-family:' + MG + ';font-weight:800;font-size:14px;color:rgba(0,0,0,.4);margin-top:4px;letter-spacing:1px;');
            iCount.textContent = (ci + 1) + ' / ' + (cats.length || 10) + ' catálogos';
            info.appendChild(iLbl); info.appendChild(iTitle); info.appendChild(iCount);
            w.appendChild(lA); w.appendChild(info); w.appendChild(rA);
            return w;
          }
        },
        /* ── 04 DESPLAZAR ── */
        {
          icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18.01"/></svg>',
          num: '04', title: 'Desplazar',
          subtitle: 'Cada división tiene productos y fichas técnicas',
          desc: 'Cada división del catálogo incluye varios productos con sus fichas técnicas completas. Haz scroll hacia abajo para ver especificaciones, tablas de medidas, colores y matrices.',
          hint: '↓ Ahora puedes deslizar para ver los productos de esta división',
          enter: function () {
            scrollBlocked = false; // suelta bloqueo de eventos de scroll
            var hint = document.getElementById('cdScrollHint');
            if (hint) { hint.classList.add('sh-visible'); }
            var activeSlide = document.querySelector('.cd-slide.is-active');
            if (activeSlide) {
              activeSlide.__oldOverflow = activeSlide.style.overflow;
              activeSlide.style.overflowY = 'auto';
              activeSlide.style.overflowX = 'hidden';
              activeSlide.scrollTop = 0;
            }
          },
          leave: function () {
            scrollBlocked = true; // re-bloquea eventos
            var hint = document.getElementById('cdScrollHint');
            if (hint) { hint.classList.remove('sh-visible'); }
            var activeSlide = document.querySelector('.cd-slide.is-active');
            if (activeSlide && activeSlide.__oldOverflow !== undefined) {
              activeSlide.style.overflowY = '';
              activeSlide.style.overflowX = '';
              activeSlide.style.overflow = activeSlide.__oldOverflow;
              delete activeSlide.__oldOverflow;
            }
          },
          demo: function () {
            var wrap = mk('div','display:flex;flex-direction:column;gap:10px;');
            var device = mk('div','border-radius:14px;background:#1b1b1c;padding:16px 14px;overflow:hidden;');
            var screen = mk('div','border-radius:8px;background:#fff;overflow-y:auto;max-height:110px;padding:10px;font-size:10px;color:#333;');
            screen.innerHTML = '<table style="width:100%;border-collapse:collapse;font-size:9px;"><thead><tr><th style="background:#FB670B;color:#fff;padding:4px 6px;">ESPECIFICACIÓN</th><th style="background:#333;color:#fff;padding:4px 6px;">MÍN</th><th style="background:#333;color:#fff;padding:4px 6px;">MÁX</th></tr></thead><tbody>' +
              '<tr><td style="padding:4px 6px;border-bottom:1px solid #eee;">Calibre</td><td style="padding:4px 6px;border-bottom:1px solid #eee;">12 µm</td><td style="padding:4px 6px;border-bottom:1px solid #eee;">30 µm</td></tr>' +
              '<tr><td style="padding:4px 6px;border-bottom:1px solid #eee;">Ancho</td><td style="padding:4px 6px;border-bottom:1px solid #eee;">250 mm</td><td style="padding:4px 6px;border-bottom:1px solid #eee;">750 mm</td></tr>' +
              '<tr><td style="padding:4px 6px;border-bottom:1px solid #eee;">Largo</td><td style="padding:4px 6px;border-bottom:1px solid #eee;">500 m</td><td style="padding:4px 6px;border-bottom:1px solid #eee;">3000 m</td></tr>' +
              '<tr><td style="padding:4px 6px;border-bottom:1px solid #eee;">Peso</td><td style="padding:4px 6px;border-bottom:1px solid #eee;">5 kg</td><td style="padding:4px 6px;border-bottom:1px solid #eee;">25 kg</td></tr></tbody></table>';
            device.appendChild(screen);
            var mouse = mk('div','display:flex;align-items:center;gap:14px;padding:0 8px;margin-top:10px;');
            var mouseIcon = mk('div','width:18px;height:25px;border:2px solid ' + O + ';border-radius:10px;display:flex;justify-content:center;padding-top:4px;');
            var wheel = mk('div','width:2.5px;height:5px;background:' + O + ';border-radius:2px;');
            mouseIcon.appendChild(wheel);
            var mouseLabel = mk('span','font-family:' + MG + ';font-weight:800;font-size:15px;text-transform:uppercase;letter-spacing:.3px;color:#111;');
            mouseLabel.textContent = 'SCROLL DENTRO DE CADA FICHA';
            mouse.appendChild(mouseIcon); mouse.appendChild(mouseLabel);
            wrap.appendChild(device); wrap.appendChild(mouse);
            return wrap;
          }
        },
        /* ── 05 PDF ── */
        {
          icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>',
          num: '05', title: 'Descargar PDF',
          subtitle: 'El catálogo a tu medida',
          desc: 'El PDF se genera en tiempo real con el idioma y tema que hayas seleccionado en los pasos anteriores. Incluye todas las fichas técnicas con especificaciones completas.',
          hint: '↓ El botón de descarga está resaltando en la página',
          enter: function () {
            var d = document.getElementById('cdDownload');
            if (!d) return;
            var r = d.getBoundingClientRect();
            if (!r.width) return;
            /* clone to body — escapes GSAP transform stacking context */
            var cl = d.cloneNode(true);
            cl.removeAttribute('id');
            cl.style.position = 'fixed';
            cl.style.top = r.top + 'px';
            cl.style.left = r.left + 'px';
            cl.style.width = r.width + 'px';
            cl.style.height = r.height + 'px';
            cl.style.zIndex = '100001';
            cl.style.margin = '0';
            cl.style.transform = 'none';
            cl.style.cursor = 'pointer';
            cl.onclick = function(e) { e.stopPropagation(); d.click(); };
            document.body.appendChild(cl); spots.push(cl);
            /* pulsing ring on top */
            var sp = document.createElement('div');
            sp.style.cssText = 'position:fixed;pointer-events:none;z-index:100002;box-sizing:border-box;border-radius:' + (getComputedStyle(d).borderRadius || '999px') + ';animation:cdTutPulse 1.15s ease-in-out infinite;top:' + r.top + 'px;left:' + r.left + 'px;width:' + r.width + 'px;height:' + r.height + 'px;';
            document.body.appendChild(sp); spots.push(sp);
          },
          leave: function() { unhl(); },
          demo: function () {
            var wrap = mk('div','display:flex;flex-direction:column;align-items:center;gap:10px;');
            var btn = mk('div','display:flex;align-items:center;gap:10px;padding:14px 28px;border-radius:14px;background:' + O + ';color:#fff;font-family:' + MG + ';font-size:20px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;box-shadow:0 6px 22px rgba(251,103,11,.38);cursor:default;');
            btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Descargar PDF';
            var note = mk('div','font-size:12px;color:rgba(0,0,0,.38);font-weight:500;text-align:center;');
            note.textContent = 'Se genera con el tema e idioma seleccionados';
            wrap.appendChild(btn); wrap.appendChild(note);
            return wrap;
          }
        }
      ];

      /* ── helpers for current theme colors ── */
      function bdr() { return isDk() ? 'rgba(255,255,255,.1)' : 'rgba(0,0,0,.09)'; }
      function mt()  { return isDk() ? '#8a8a8a' : '#6B7280'; }
      function bg()  { return isDk() ? '#181818' : '#ffffff'; }
      function txt() { return isDk() ? '#F0EFE8' : '#0f172a'; }

      /* ── RENDER ── */
      function render() {
        window.__cdHowCur = cur;
        card.innerHTML = '';
        var s = steps[cur];
        var isLast = cur === steps.length - 1;
        var sNext = !isLast ? steps[cur + 1] : null;
        var sPrev = cur > 0 ? steps[cur - 1] : null;

        /* ═══ TOP BAR ═══ */
        var topBar = mk('div','display:flex;justify-content:space-between;align-items:center;padding:18px 20px 0;');
        /* step dots */
        var dotsWrap = mk('div','display:flex;gap:5px;align-items:center;');
        steps.forEach(function(_,i){
          var d = mk('div','height:3px;border-radius:2px;transition:all .35s;');
          d.style.background = i===cur ? O : 'rgba(0,0,0,.12)';
          d.style.width = i===cur ? '24px' : '8px';
          dotsWrap.appendChild(d);
        });
        /* right: counter + close */
        var rightTop = mk('div','display:flex;align-items:center;gap:10px;');
        var stepLbl = mk('span','font-size:12px;font-weight:600;color:rgba(0,0,0,.35);letter-spacing:.2px;');
        stepLbl.textContent = (cur+1) + ' de ' + steps.length;
        var xb = mk('button','width:28px;height:28px;border-radius:50%;border:none;background:rgba(0,0,0,.07);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;color:rgba(0,0,0,.45);transition:background .2s;padding:0;');
        xb.type='button'; xb.innerHTML='&times;';
        xb.onmouseenter=function(){xb.style.background='rgba(0,0,0,.13)';};
        xb.onmouseleave=function(){xb.style.background='rgba(0,0,0,.07)';};
        xb.onclick=function(){s.leave();close();};
        rightTop.appendChild(stepLbl); rightTop.appendChild(xb);
        topBar.appendChild(dotsWrap); topBar.appendChild(rightTop);
        card.appendChild(topBar);

        /* ═══ HERO ═══ */
        var hero = mk('div','padding:20px 24px 18px;');
        var numEl = mk('div','font-family:' + MG + ';font-weight:800;font-size:72px;line-height:.85;color:' + O + ';letter-spacing:-2px;');
        numEl.textContent = s.num;
        var titleEl = mk('div','font-family:' + MG + ';font-weight:800;font-size:32px;text-transform:uppercase;color:#111;line-height:1;margin-top:6px;letter-spacing:.3px;');
        titleEl.textContent = s.title;
        var subEl = mk('div','font-size:13px;color:rgba(0,0,0,.42);margin-top:6px;line-height:1.4;font-weight:500;');
        subEl.textContent = s.subtitle;
        hero.appendChild(numEl); hero.appendChild(titleEl); hero.appendChild(subEl);
        card.appendChild(hero);

        /* separator */
        card.appendChild(mk('div','height:1px;background:rgba(0,0,0,.07);'));

        /* ═══ BODY ═══ */
        var body = mk('div','padding:18px 20px;');
        body.appendChild(s.demo());
        card.appendChild(body);

        /* separator */
        card.appendChild(mk('div','height:1px;background:rgba(0,0,0,.07);'));

        /* ═══ FOOTER ═══ */
        var foot = mk('div','padding:14px 20px 18px;display:flex;gap:8px;');
        if (sPrev) {
          var bp = mk('button','flex:0 0 auto;padding:16px 20px;border-radius:12px;border:none;background:#EBEBEB;color:#333;cursor:pointer;transition:background .2s;font-family:' + MG + ';font-size:20px;font-weight:800;letter-spacing:.3px;white-space:nowrap;display:flex;align-items:center;gap:8px;');
          bp.type='button';
          var bpArr = mk('span','font-size:13px;opacity:.45;'); bpArr.textContent = '←';
          var bpTxt = mk('span','font-family:' + MG + ';font-weight:800;font-size:20px;letter-spacing:.4px;text-transform:uppercase;'); bpTxt.textContent = sPrev.num;
          bp.appendChild(bpArr); bp.appendChild(bpTxt);
          bp.onmouseenter=function(){bp.style.background='#DCDCDC';};
          bp.onmouseleave=function(){bp.style.background='#EBEBEB';};
          bp.onclick=function(){s.leave();cur--;render();};
          foot.appendChild(bp);
        }
        var bn = mk('button','flex:1;padding:16px 16px;border-radius:12px;border:none;background:' + O + ';color:#fff;cursor:pointer;transition:opacity .18s;font-family:' + MG + ';font-size:22px;font-weight:800;letter-spacing:.4px;box-shadow:0 4px 18px rgba(251,103,11,.38);display:flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap;');
        bn.type='button';
        if (isLast) {
          bn.textContent = 'TERMINAR ✓';
        } else {
          var bnTxt = mk('span','font-family:' + MG + ';font-weight:800;font-size:22px;letter-spacing:.5px;text-transform:uppercase;');
          bnTxt.textContent = sNext.num + ' ' + sNext.title.toUpperCase();
          var bnArr = mk('span','font-size:16px;opacity:.65;');
          bnArr.textContent = '→';
          bn.appendChild(bnTxt); bn.appendChild(bnArr);
        }
        bn.onmouseenter=function(){bn.style.opacity='.85';};
        bn.onmouseleave=function(){bn.style.opacity='1';};
        bn.onclick=function(e){e.stopPropagation();if(isLast){s.leave();close();}else{s.leave();cur++;render();}};
        foot.appendChild(bn);
        card.appendChild(foot);

        s.enter();
      }

      render();
      ov.appendChild(card);
      document.body.appendChild(ov);
      // solo se cierra con X o Escape — no con click en el fondo
    }

    function bind() {
      var b = document.getElementById('cdHowBtn');
      if (!b || b.__hb) return; b.__hb = true;
      b.addEventListener('click', openHowModal);
      // tutorial auto-reabre al navegar entre catálogos
      try {
        if (sessionStorage.getItem('cdTutActive') === '1') {
          sessionStorage.removeItem('cdTutActive');
          setTimeout(openHowModal, 400);
        }
      } catch (_) {}
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
    else bind();
    document.addEventListener('astro:page-load', bind);
    document.addEventListener('astro:after-swap', bind);
  })();
  </script>
</BaseLayout>
