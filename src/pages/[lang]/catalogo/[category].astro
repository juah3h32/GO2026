---
// src/pages/[lang]/catalogo-digital.astro
// Catalogo digital animado — division STRETCH FILM.
// Diseno y datos espejo de las laminas oficiales del Product Catalog.
// SSR: lee el catalogo de Turso en cada request -> refleja cambios al instante (Vercel).
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Footer from "../../../components/Footer.astro";
import ProductTitle from "../../../components/ProductTitle.astro";
import { translations } from "../../../i18n";
import { getCatalog } from "../../../lib/catalog-store.js";
import { getCatalogMeta, listCatalogsMeta, DIV_TITLES } from "../../../lib/catalogs.js";

const { lang, category } = Astro.params;
const currentLang = (lang as string) || "es";
const slug = category || "digital-stretch-film";
const meta = getCatalogMeta(slug);
const catalogData: any = await getCatalog(slug);
const { productos, fichas, intro, coverImg, visualCover } = catalogData;
const catalogStyles = catalogData.styles || {};
const cover = catalogData.cover || { t1: "STRETCH", t2: "FILM", division: "" };
const imgFolder = meta.imgFolder || "stretch";
const coverFolder = meta.coverImgFolder || "catalogos";

// Acepta URL absoluta (Cloudinary), ruta local, o nombre de archivo.
const IMG = (n: string) => /^https?:\/\//.test(n) ? n : (n.startsWith('/') ? n : `/images/${imgFolder}/${n}`);
const IMG_CAT = (n: string) => /^https?:\/\//.test(n) ? n : (n.startsWith('/') ? n : `/images/${coverFolder}/${n}`);

// Valores seguros para la portada
const vc = visualCover || { scale: 1, offsetX: 0, offsetY: 0, rotate: 0 };
const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || 'dfuzfdrat';

const divisionImgs: Record<string, string> = {
  'digital-stretch-film':  '/images/divisiones/film-estirable.webp',
  'digital-acolchado':     '/images/divisiones/acolchado.webp',
  'digital-arpilla':       '/images/divisiones/arpilla.webp',
  'digital-cuerda':        '/images/divisiones/cuerdas.webp',
  'digital-rafia':         '/images/divisiones/rafia.webp',
  'digital-flexible':      '/images/divisiones/bolsa.webp',
  'digital-saco':          '/images/divisiones/sacos.webp',
  'digital-esquinero':     '/images/divisiones/esquineros.webp',
  'digital-naturizable':   '/images/divisiones/desechables.webp',
  'digital-bolsas':        '/images/divisiones/bolsas.webp',
};

// Helper de traduccion para el JSON
// Quita el simbolo ® de cualquier texto (regla: nunca debe salir en catalogo ni PDF)
const stripR = (s: any) => typeof s === 'string' ? s.replace(/®/g, '') : s;
const T = (obj: any) => {
  if (obj && typeof obj === 'object' && !Array.isArray(obj)) {
    const v = obj[currentLang];
    if (v !== undefined && v !== null && v !== '') return stripR(v);
    return obj.es !== undefined && obj.es !== null ? stripR(obj.es) : '';
  }
  return obj == null ? '' : stripR(obj);
};

// Traducimos los datos antes de inyectarlos
const introTr = {
  p1: T(intro.p1),
  bioTitle: T(intro.bioTitle),
  p2: T(intro.p2)
};
const coverTr = {
  t1: T(cover.t1),
  t2: T(cover.t2),
  division: T(cover.division)
};
// La lista de portada se deriva de los nombres de las fichas: si borras/renombras una ficha,
// la portada se actualiza sola (quedan siempre vinculadas). Fallback al array productos legacy.
const productosTr = (Array.isArray(fichas) && fichas.length) ? fichas.map(f => T(f.nombre)) : productos.map(T);
const manyProds = productosTr.length > 3; // >3: lista horizontal al pie, deja arriba libre para la imagen
const _ne = (v: any) => v !== '' && v !== null && v !== undefined;
const fichasTr = fichas.map(f => {
  const specs = (f.specs || []).map(s => ({ ...s, c: T(s.c), tol: T(s.tol), min: T(s.min), max: T(s.max), uni: T(s.uni), met: T(s.met) }));
  const cols = {
    min: specs.some(s => _ne(s.min)),
    max: specs.some(s => _ne(s.max)),
    tol: specs.some(s => _ne(s.tol)),
    uni: specs.some(s => _ne(s.uni)),
    met: specs.some(s => _ne(s.met)),
  };
  // single = solo un valor por fila (sin rango min/max): ej bolsas (Ancho/Alto/Material/Uso)
  const single = cols.min && !cols.max;
  // pares para tabla simple a 2 columnas-par (llena el ancho, no se ve vacia)
  const specPairs = [];
  if (single) { for (let i = 0; i < specs.length; i += 2) specPairs.push([{ s: specs[i], i }, specs[i + 1] ? { s: specs[i + 1], i: i + 1 } : null]); }
  const sections = Array.isArray(f.sections) ? f.sections.map(sec => ({
    title: T(sec.title),
    items: (sec.items || []).map(it => T(it)),
  })) : [];
  return { ...f, nombre: T(f.nombre), desc: T(f.desc), sections, specs, cols, single, specPairs };
});

const dc: any = (translations[currentLang] as any)?.digital_catalog || {};
const common: any = (translations[currentLang] as any)?.common || {};
// Diccionario UI de la portada/tabla (fallback garantizado por idioma; i18n puede estar incompleto)
const UI: any = {
  es: { downloadPDF: 'Descargar PDF', exploreCatalog: 'Explora nuestro catálogo', catGeneral: 'Catálogo General', distributor: 'Quiero ser distribuidor', scrollHint: 'Deslizar para ver más', products: 'Productos', characteristics: 'CARACTERÍSTICAS', measurement: 'MEDICIÓN', tolerances: 'TOLERANCIAS', unit: 'UNIDAD', testMethod: 'MÉTODO DE PRUEBA', min: 'MÍNIMO', max: 'MÁXIMO', value: 'VALOR', soon: 'PRÓXIMAMENTE', soonNote: 'Este producto estará disponible pronto.', titlePart1: 'CATÁLOGO DE', titlePart2: 'PRODUCTOS', division: 'DIVISIÓN', howBtn: '¿Cómo funciona?', flapLabel: 'DIVISIONES', divisions: 'DIVISIONES', digitalCatalogs: 'CATÁLOGOS DIGITALES', genSup: 'CATÁLOGO GENERAL', genSub: 'GRUPO ORTIZ · TODAS LAS DIVISIONES', genPreparing: 'PREPARANDO', genGenerating: 'GENERANDO PDFS', genMerging: 'UNIENDO PÁGINAS', genDone: 'COMPLETADO', genErrTitle: 'No se pudo generar', genErrMsg: 'Intenta de nuevo en un momento', genRetry: 'Reintentar', genDownloading: 'Generando PDF…', genInProgress: 'DESCARGA EN CURSO', quote: 'Cotizar', selSingular: 'seleccionado', selPlural: 'seleccionados', quoteHello: 'Hola! Me interesa cotizar los siguientes productos de ', quoteAsk: '¿Podrían proporcionarme más información y precios?' },
  en: { downloadPDF: 'Download PDF', exploreCatalog: 'Explore our catalog', catGeneral: 'General Catalog', distributor: 'Become a distributor', scrollHint: 'Scroll to see more', products: 'Products', characteristics: 'CHARACTERISTICS', measurement: 'MEASUREMENT', tolerances: 'TOLERANCES', unit: 'UNIT', testMethod: 'TEST METHOD', min: 'MINIMUM', max: 'MAXIMUM', value: 'VALUE', soon: 'COMING SOON', soonNote: 'This product will be available soon.', titlePart1: 'CATALOG OF', titlePart2: 'PRODUCTS', division: 'DIVISION', howBtn: 'How it works?', flapLabel: 'DIVISIONS', divisions: 'DIVISIONS', digitalCatalogs: 'DIGITAL CATALOGS', genSup: 'GENERAL CATALOG', genSub: 'GRUPO ORTIZ · ALL DIVISIONS', genPreparing: 'PREPARING', genGenerating: 'GENERATING PDFS', genMerging: 'MERGING PAGES', genDone: 'COMPLETED', genErrTitle: 'Could not generate', genErrMsg: 'Try again in a moment', genRetry: 'Retry', genDownloading: 'Generating PDF…', genInProgress: 'DOWNLOADING', quote: 'Quote', selSingular: 'selected', selPlural: 'selected', quoteHello: 'Hi! I\'m interested in quoting the following products from ', quoteAsk: 'Could you provide more information and pricing?' },
  pt: { downloadPDF: 'Baixar PDF', exploreCatalog: 'Explore nosso catálogo', catGeneral: 'Catálogo Geral', distributor: 'Quero ser distribuidor', scrollHint: 'Deslize para ver mais', products: 'Produtos', characteristics: 'CARACTERÍSTICAS', measurement: 'MEDIÇÃO', tolerances: 'TOLERÂNCIAS', unit: 'UNIDADE', testMethod: 'MÉTODO DE TESTE', min: 'MÍNIMO', max: 'MÁXIMO', value: 'VALOR', soon: 'EM BREVE', soonNote: 'Este produto estará disponível em breve.', titlePart1: 'CATÁLOGO DE', titlePart2: 'PRODUTOS', division: 'DIVISÃO', howBtn: 'Como funciona?', flapLabel: 'DIVISÕES', divisions: 'DIVISÕES', digitalCatalogs: 'CATÁLOGOS DIGITAIS', genSup: 'CATÁLOGO GERAL', genSub: 'GRUPO ORTIZ · TODAS AS DIVISÕES', genPreparing: 'PREPARANDO', genGenerating: 'GERANDO PDFS', genMerging: 'UNINDO PÁGINAS', genDone: 'CONCLUÍDO', genErrTitle: 'Não foi possível gerar', genErrMsg: 'Tente novamente em instantes', genRetry: 'Tentar novamente', genDownloading: 'Gerando PDF…', genInProgress: 'BAIXANDO', quote: 'Cotar', selSingular: 'selecionado', selPlural: 'selecionados', quoteHello: 'Olá! Tenho interesse em cotar os seguintes produtos de ', quoteAsk: 'Poderiam me fornecer mais informações e preços?' },
  zh: { downloadPDF: '下载 PDF', exploreCatalog: '探索我们的目录', catGeneral: '综合目录', distributor: '成为分销商', scrollHint: '滚动查看更多', products: '产品', characteristics: '特性', measurement: '测量', tolerances: '公差', unit: '单位', testMethod: '测试方法', min: '最小值', max: '最大值', value: '数值', soon: '即将推出', soonNote: '该产品即将上市。', titlePart1: '产品', titlePart2: '目录', division: '部门', howBtn: '如何使用？', flapLabel: '目录', divisions: '目录', digitalCatalogs: '数字目录', genSup: '综合目录', genSub: 'GRUPO ORTIZ · 所有部门', genPreparing: '准备中', genGenerating: '生成PDF中', genMerging: '合并页面', genDone: '已完成', genErrTitle: '生成失败', genErrMsg: '请稍后重试', genRetry: '重试', genDownloading: '生成PDF…', genInProgress: '下载中', quote: '询价', selSingular: '已选', selPlural: '已选', quoteHello: '您好！我想询价以下产品（', quoteAsk: '请问能提供详细信息和报价吗？' },
  ar: { downloadPDF: 'تنزيل PDF', exploreCatalog: 'استكشف كتالوجنا', catGeneral: 'الكتالوج العام', distributor: 'كن موزعًا', scrollHint: 'اسحب لرؤية المزيد', products: 'المنتجات', characteristics: 'الخصائص', measurement: 'القياس', tolerances: 'التفاوتات', unit: 'الوحدة', testMethod: 'طريقة الاختبار', min: 'الحد الأدنى', max: 'الحد الأقصى', value: 'القيمة', soon: 'قريباً', soonNote: 'سيتوفر هذا المنتج قريباً.', titlePart1: 'كتالوج', titlePart2: 'المنتجات', division: 'قسم', howBtn: 'كيف يعمل؟', flapLabel: 'الأقسام', divisions: 'الأقسام', digitalCatalogs: 'كتالوجات رقمية', genSup: 'الكتالوج العام', genSub: 'GRUPO ORTIZ · جميع الأقسام', genPreparing: 'جارٍ التحضير', genGenerating: 'توليد PDF', genMerging: 'دمج الصفحات', genDone: 'اكتمل', genErrTitle: 'تعذر الإنشاء', genErrMsg: 'حاول مرة أخرى', genRetry: 'إعادة المحاولة', genDownloading: 'توليد PDF…', genInProgress: 'جارٍ التنزيل', quote: 'طلب عرض سعر', selSingular: 'محدد', selPlural: 'محددة', quoteHello: 'مرحباً! أرغب في الاستفسار عن أسعار المنتجات التالية من ', quoteAsk: 'هل يمكنكم تزويدي بمزيد من المعلومات والأسعار؟' }
};
const ui: any = UI[currentLang] || UI.es;

const getDivTitle = (s: string) => (DIV_TITLES[s]?.[currentLang]) || (DIV_TITLES[s]?.es) || s;

const ctTitle: any = { es: 'Catálogo de Productos | Grupo Ortiz', en: 'Product Catalog | Grupo Ortiz', pt: 'Catálogo de Produtos | Grupo Ortiz', zh: '产品目录 | Grupo Ortiz', ar: 'كتالوج المنتجات | Grupo Ortiz' };

// Title/description por división — evita contenido duplicado entre los 10 catálogos
// (antes todas las divisiones compartían el mismo title/description de Stretch Film).
const divTitle = getDivTitle(slug);
const CD_META_TEMPLATES: any = {
  es: { title: (d: string) => `Catálogo de ${d} en Morelia | Grupo Ortiz`, desc: (d: string) => `Catálogo digital de ${d} de Grupo Ortiz, fabricante en Morelia, Michoacán desde 1959. Especificaciones técnicas completas.` },
  en: { title: (d: string) => `${d} Catalog | Grupo Ortiz, Morelia`, desc: (d: string) => `Digital catalog of ${d} from Grupo Ortiz, manufacturer in Morelia, Michoacán since 1959. Full technical specifications.` },
  pt: { title: (d: string) => `Catálogo de ${d} em Morelia | Grupo Ortiz`, desc: (d: string) => `Catálogo digital de ${d} da Grupo Ortiz, fabricante em Morelia, Michoacán desde 1959. Especificações técnicas completas.` },
  zh: { title: (d: string) => `${d}目录 | Grupo Ortiz 莫雷利亚`, desc: (d: string) => `Grupo Ortiz ${d}数字目录，自1959年起在莫雷利亚（米却肯州）生产制造。完整技术规格。` },
  ar: { title: (d: string) => `كتالوج ${d} | Grupo Ortiz موريليا`, desc: (d: string) => `الكتالوج الرقمي لـ ${d} من Grupo Ortiz، المصنّعة في موريليا، ميتشواكان منذ عام 1959. مواصفات تقنية كاملة.` },
};
const cdMeta = CD_META_TEMPLATES[currentLang] || CD_META_TEMPLATES.es;
const pageTitle = divTitle ? cdMeta.title(divTitle) : (dc.title || ctTitle[currentLang] || ctTitle.es);
const pageDescription = divTitle ? cdMeta.desc(divTitle) : "Catálogo digital de Grupo Ortiz, fabricante en Morelia, Michoacán desde 1959.";

const t: any = {
  catalogTitle: dc.title || ctTitle[currentLang] || ctTitle.es,
  catalogTitlePart1: dc.titlePart1 || ui.titlePart1,
  catalogTitlePart2: dc.titlePart2 || ui.titlePart2,
  downloadPDF: dc.downloadPDF || ui.downloadPDF,
  distributor: dc.distributor || ui.distributor,
  products: dc.products || ui.products,
  characteristics: dc.characteristics || ui.characteristics,
  measurement: dc.measurement || ui.measurement,
  tolerances: dc.tolerances || ui.tolerances,
  unit: dc.unit || ui.unit,
  testMethod: dc.testMethod || ui.testMethod,
  min: dc.min || ui.min,
  max: dc.max || ui.max,
  value: ui.value,
  soon: ui.soon,
  soonNote: ui.soonNote,
  division: common.division || ui.division
};

// Etiquetas tabla de medidas por color (traducidas)
const CT_LABELS: any = {
  es: { color: 'Color', in: 'Medidas (pulgadas)', yd: 'Medidas (yardas)' },
  en: { color: 'Color', in: 'Measures (inches)', yd: 'Measures (yards)' },
  pt: { color: 'Cor', in: 'Medidas (polegadas)', yd: 'Medidas (jardas)' },
  zh: { color: '颜色', in: '尺寸（英寸）', yd: '尺寸（码）' },
  ar: { color: 'اللون', in: 'القياسات (بوصة)', yd: 'القياسات (ياردة)' }
};
const ctl = CT_LABELS[currentLang] || CT_LABELS.es;

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug={`catalogo/${slug}/`}
  currentLang={currentLang}
  moveLogoMobile={true}
>
  <main class="cd" data-division={`${coverTr.t1}${coverTr.t2 ? ' ' + coverTr.t2 : ''}`}>
    <div class="cd-ed-guides" aria-hidden="true"></div>
    <div class="cd-deck" id="cdDeck">

    <!-- ── HERO / PORTADA DIVISION ──────────────────────────────── -->
    <section class={`cd-slide cd-hero ${manyProds ? "cd-hero-prodrow" : ""}`}>
      <header class="cd-bar cd-bar-sec">
        <div></div>
        <div class="cd-site"><span class="cd-site-line"></span>GRUPO-ORTIZ.COM</div>
      </header>
      <div class="cd-hero-media">
        <div style={`transform: translate(${vc.offsetX}%, ${vc.offsetY}%) scale(${vc.scale}) rotate(${vc.rotate || 0}deg); overflow: ${vc.clip ? 'hidden' : 'visible'}; transition: transform 0.1s ease;`}>
          <img src={IMG_CAT(coverImg)} alt="Rollo de stretch film Grupo Ortiz" loading="eager" decoding="async" style={`transform: scale(${vc.zoom || 1});${(vc.clipTop || vc.clipBottom) ? ` clip-path: inset(${vc.clipTop || 0}% 0 ${vc.clipBottom || 0}% 0);` : ''}`} />
        </div>
      </div>
      <div class="cd-hero-inner">
        <h1 class="cd-hero-title">
          <span class="cd-w cd-orange reveal" data-cd-path="cover.t1">{coverTr.t1}</span>
          {coverTr.t2 && <span class="cd-w cd-gray reveal" style="--d:.1s" data-cd-path="cover.t2">{coverTr.t2}</span>}
        </h1>
        <div class="cd-hero-div reveal" style="--d:.18s" data-cd-path="cover.division">{coverTr.division || t.division || "DIVISIÓN"}</div>
        <p class="cd-hero-tagline">{introTr.p1 || ui.exploreCatalog}</p>
        <div class="cd-hero-copy reveal" style="--d:.26s">
          <p data-cd-path="intro.p1">{introTr.p1}</p>
          <p class="cd-bio-t" data-cd-path="intro.bioTitle">{introTr.bioTitle}</p>
          <p data-cd-path="intro.p2">{introTr.p2}</p>
        </div>
        <div class="cd-hero-actions reveal" style="--d:.4s">
          <a class="cd-dl" id="cdDownload" href={`/api/catalogo-pdf?lang=${currentLang}&catalog=${slug}`} download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span class="cd-dl-txt">{t.downloadPDF || "Descargar PDF"}</span>
          </a>
          <button class="cd-dl cd-dl-general cd-ed-h" id="cdDownloadGeneral" type="button" aria-label="Descargar catálogo general con todas las divisiones">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span class="cd-dl-txt">{ui.catGeneral}</span>
          </button>
          <a class="cd-btn-hero" href={`/${currentLang}/distribuidor`}>
            <span>{t.distributor || "Quiero ser distribuidor"}</span>
            <i class="cd-chevs" style="font-size: 1.2em; margin-left: 4px;">&raquo;</i>
          </a>
        </div>
      </div>
      <div class="cd-hero-prods reveal" style="--d:.34s">
        <span class="cd-prods-t">{t.products || "Productos"}:</span>
        <ul>
          {productosTr.map((p, i) => (<li style={`--d:${0.36 + i * 0.05}s`} data-cd-path={`fichas.${i}.nombre`}>- {p}</li>))}
        </ul>
      </div>
      <div class="cd-year">2026</div>
    </section>

    <!-- ── Grid de productos (movil) ───────────────────────────── -->
    <div class="cd-mobgrid">
      {fichasTr.map((f, i) => (
        <div class={`cd-mgcard${f.soon ? ' is-soon' : ''}`}>
          <div class="cd-mgcard__img">
            <span class="cd-mgcard__num">{String(i + 1).padStart(2, '0')}</span>
            <img src={IMG(f.img)} alt={f.nombre} loading="lazy" decoding="async" />
            {f.soon && <span class="cd-mgcard__soon-badge">{t.soon}</span>}
          </div>
          <div class="cd-mgcard__name">{f.nombre}</div>
        </div>
      ))}
    </div>

    <!-- ── FICHAS TECNICAS ──────────────────────────────────────── -->
    {fichasTr.map((f, idx) => (
      <section class={`cd-slide cd-ficha ${f.lado === "left" ? "is-left" : ""} ${f.soon ? "is-soon" : ""}`} data-ficha-name={f.nombre} data-ficha-idx={String(idx)}>
        <button class="cd-sel-chip" type="button" aria-label={`Seleccionar ${f.nombre}`}>
          <svg width="13" height="10" viewBox="0 0 13 10" fill="none"><polyline points="1.5,5 5,8.5 11.5,1.5" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="cd-ficha-bg" aria-hidden="true"></div>

        <header class="cd-bar cd-bar-sec">
          <div class="cd-logo">
            <span class="cd-logo-1">{t.catalogTitlePart1 || "CATÁLOGO DE"}</span>
            <span class="cd-logo-2"><i class="cd-chevs">&raquo;</i>{t.catalogTitlePart2 || "PRODUCTOS"}</span>
          </div>
          <div class="cd-site"><span class="cd-site-line"></span>GRUPO-ORTIZ.COM</div>
        </header>

        <div class="cd-ficha-head">
          <div class="cd-ficha-copy">
            <ProductTitle nombre={f.nombre} idx={idx} />
            <p class="cd-p reveal" style="--d:.08s" data-cd-path={`fichas.${idx}.desc`}>{f.desc}</p>
          </div>
          <div class="cd-ficha-media reveal ${f.soon ? 'media-soon' : ''}">
            <div class="cd-ficha-media-inner" style={`transform: translate(${f.visual?.offsetX || 0}%, ${f.visual?.offsetY || 0}%) scale(${f.visual?.scale || 1}) rotate(${f.visual?.rotate || 0}deg); overflow: ${f.visual?.clip ? 'hidden' : 'visible'};`}>
              <img src={IMG(f.img)} alt={f.nombre} loading="lazy" decoding="async" style={`transform: scale(${f.visual?.zoom || 1});${(f.visual?.clipTop || f.visual?.clipBottom) ? ` clip-path: inset(${f.visual?.clipTop || 0}% 0 ${f.visual?.clipBottom || 0}% 0);` : ''}`} />
            </div>
            {f.soon && (
              <div class="cd-soon-overlay" aria-hidden="true">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span>{t.soon}</span>
              </div>
            )}
          </div>
        </div>

        {f.soon && (
          <div class="cd-soon-note reveal" style="--d:.12s">{t.soonNote}</div>
        )}

        {!f.soon && Array.isArray(f.sections) && f.sections.length > 0 && (
          <div class="cd-sections reveal" style="--d:.10s">
            {f.sections.map((sec) => (
              <div class="cd-sec">
                <div class="cd-sec-tag">{sec.title}</div>
                <ul class="cd-sec-list">
                  {(sec.items || []).map((item) => (<li>{item}</li>))}
                </ul>
              </div>
            ))}
          </div>
        )}

        {!f.soon && f.specs.length > 0 && f.single && (
        <div class="cd-table-wrap reveal" style="--d:.12s">
          <table class="cd-table cd-table-h">
            <thead>
              <tr>
                {f.specs.map((s, i) => (<th class={i % 2 === 0 ? 'th-o' : 'th-g'} data-cd-path={`fichas.${idx}.specs.${i}.c`}>{s.c}</th>))}
              </tr>
            </thead>
            <tbody>
              <tr>
                {f.specs.map((s) => (<td class="td-n">{s.min}{s.uni ? (' ' + s.uni) : ''}</td>))}
              </tr>
            </tbody>
          </table>
        </div>
        )}

        {!f.soon && f.specs.length > 0 && !f.single && (
        <div class="cd-table-wrap reveal" style="--d:.12s">
          <table class="cd-table">
            <thead>
              <tr>
                <th class="th-o" rowspan="2">{t.characteristics}</th>
                <th class="th-g" colspan="2">{t.measurement}</th>
                {f.cols.tol && <th class="th-o" rowspan="2">{t.tolerances}</th>}
                {f.cols.uni && <th class="th-g" rowspan="2">{t.unit}</th>}
                {f.cols.met && <th class="th-o" rowspan="2">{t.testMethod}</th>}
              </tr>
              <tr>
                <th class="th-g" style="font-size: 9px; padding-top: 2px; padding-bottom: 2px;">{t.min}</th>
                <th class="th-g" style="font-size: 9px; padding-top: 2px; padding-bottom: 2px;">{t.max}</th>
              </tr>
            </thead>
            <tbody>
              {f.specs.map((s, i) => (
                <tr class={s.hl ? 'cd-hl' : ''} style={`--d:${i * 0.04}s`}>
                  <td class="td-c" data-cd-path={`fichas.${idx}.specs.${i}.c`}>{s.c}</td>
                  <td class="td-n">{s.min}</td>
                  <td class="td-n">{s.max}</td>
                  {f.cols.tol && <td class="td-n">{s.tol}</td>}
                  {f.cols.uni && <td class="td-n">{s.uni}</td>}
                  {f.cols.met && <td class="td-n" style="font-size:11px;">{s.met}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        )}

        {!f.soon && f.colorTable && Array.isArray(f.colorTable.rows) && f.colorTable.rows.length > 0 && (
        <div class="cd-ctable-wrap reveal" style="--d:.12s">
          <table class="cd-ctable">
            <thead>
              <tr>
                <th class="th-o">{ctl.color}</th>
                <th class="th-g">{ctl.in}</th>
                <th class="th-g">{ctl.yd}</th>
              </tr>
            </thead>
            <tbody>
              {f.colorTable.rows.map((r, i) => (
                <tr style={`--d:${i * 0.04}s`}>
                  <td class="ct-color">{T(r.color)}</td>
                  <td class="ct-m">{r.in}</td>
                  <td class="ct-m">{r.yd}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        )}

        {!f.soon && f.matrix && Array.isArray(f.matrix.rows) && f.matrix.rows.length > 0 && (
        <div class="cd-mtable-wrap reveal" style="--d:.12s">
          {f.matrix.title && <div class="cd-mtable-title">{T(f.matrix.title)}</div>}
          <div class="cd-mtable-scroll">
            <table class="cd-mtable">
              {Array.isArray(f.matrix.headers) && f.matrix.headers.length > 0 && (
                <thead>
                  <tr>{f.matrix.headers.map((h, hi) => (<th class={hi === 0 ? 'th-o' : 'th-g'}>{T(h)}</th>))}</tr>
                </thead>
              )}
              <tbody>
                {f.matrix.rows.map((r, i) => (
                  <tr style={`--d:${i * 0.04}s`}>
                    <td class="mt-label">{T(r.label)}</td>
                    {(r.cells || []).map((cell) => (<td class="mt-cell">{cell}</td>))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {f.matrix.note && <p class="cd-mtable-note">{T(f.matrix.note)}</p>}
        </div>
        )}
      </section>
    ))}

    </div><!-- /cd-deck -->

    <!-- Hidden nav: keeps JS IDs alive, not visible -->
    <div aria-hidden="true" style="display:none">
      <button id="cdPrev" type="button"></button>
      <span id="cdCur"></span><span id="cdTot"></span>
      <button id="cdNext" type="button"></button>
    </div>

    <!-- Scroll hint: shown on first slide only -->
    <div class="cd-scroll-hint" id="cdScrollHint">
      <div class="cd-scroll-mouse">
        <div class="cd-scroll-wheel"></div>
      </div>
      <span>{ui.scrollHint}</span>
    </div>

    <!-- Navegación entre catálogos (admin) -->
    <div id="cdCatNav"></div>

    <!-- Navegación mobile (fixed bottom) -->
    {(() => {
      const cats = listCatalogsMeta();
      const catIdx = cats.findIndex(c => c.slug === slug);
      const prevCat = catIdx > 0 ? cats[catIdx - 1] : null;
      const nextCat = catIdx < cats.length - 1 ? cats[catIdx + 1] : null;
      return (
        <nav class="cd-mob-nav" aria-label="Navegación entre divisiones">
          {prevCat ? (
            <a href={`/${currentLang}/catalogo/${prevCat.slug}`} class="cd-mob-arrow" aria-label={`Anterior: ${prevCat.title}`}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </a>
          ) : <span class="cd-mob-arrow is-disabled"></span>}
          <span class="cd-mob-current">{getDivTitle(slug)}</span>
          {nextCat ? (
            <a href={`/${currentLang}/catalogo/${nextCat.slug}`} class="cd-mob-arrow" aria-label={`Siguiente: ${nextCat.title}`}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </a>
          ) : <span class="cd-mob-arrow is-disabled"></span>}
        </nav>
      );
    })()}

    <!-- Floating ¿Cómo funciona? button -->
    <button class="cd-how-fab cd-ed-h" id="cdHowBtn" type="button" aria-label={ui.howBtn}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <span>{ui.howBtn}</span>
    </button>
  </main>

  <!-- Overlay fullscreen descarga catálogo general -->
  <div class="cd-gen-overlay" id="cdGenOverlay" style="display:none">
    <div class="cd-gen-year-bg" aria-hidden="true">2026</div>
    <div class="cd-gen-card" id="cdGenProgress">
      <div class="cd-gen-hd">
        <div class="cd-gen-sup">{ui.genSup}</div>
        <div class="cd-gen-txt" id="cdGenTxt">{ui.genPreparing}</div>
        <div class="cd-gen-sub">{ui.genSub}</div>
      </div>
      <div class="cd-gen-grid" id="cdGenGrid"></div>
      <div class="cd-gen-ft">
        <div class="cd-gen-bar-wrap">
          <div class="cd-gen-bar" id="cdGenBar"></div>
        </div>
        <div class="cd-gen-stats-row">
          <span class="cd-gen-count" id="cdGenCount">0 / —</span>
          <span class="cd-gen-mb" id="cdGenMb">0.0 MB</span>
        </div>
      </div>
    </div>
    <div class="cd-gen-card cd-gen-err-card" id="cdGenErrCard" style="display:none">
      <div class="cd-gen-err-icon">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <div class="cd-gen-err-title">{ui.genErrTitle}</div>
      <div class="cd-gen-err-msg" id="cdGenErrMsg">{ui.genErrMsg}</div>
      <button class="cd-gen-err-retry" id="cdGenRetry">{ui.genRetry}</button>
    </div>
  </div>

  <div class="cat-sel-fab" id="catSelFab">
    <span class="cat-sel-count" id="catSelCount">0</span>
    <span class="cat-sel-lbl" id="catSelLbl">{ui.selPlural}</span>
    <button class="cat-sel-cta" id="catSelCta" type="button">
      {ui.quote}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </button>
  </div>

  <!-- Pestaña lateral — todas las divisiones del catálogo -->
  <button class="cd-divpick-flap" id="cdDivPickFlap" type="button" aria-label="Ver todas las divisiones">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
      <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
    </svg>
    <span class="cd-divpick-flap-label">{ui.flapLabel}</span>
