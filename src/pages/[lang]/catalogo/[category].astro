      // ── Subir imagen (Cloudinary catalogos/<cat> + copia local) ──
      function edUpload() {
        var inp = document.createElement('input'); inp.type = 'file'; inp.accept = 'image/png,image/jpeg,image/webp';
        inp.onchange = function () {
          var file = inp.files && inp.files[0]; if (!file) return;
          // Captura el destino al momento del click (no al resolver la promesa)
          var curIdx = idx, curBound = boundEl;
          var fd = new FormData();
          fd.append('file', file);
          fd.append('target', curIdx === 0 ? 'cover' : String(curIdx - 1));
          fd.append('category', imgFolder || 'stretch');
          if (edFields.msg) { edFields.msg.style.color = '#9CA3AF'; edFields.msg.textContent = 'Subiendo...'; }
          fetch('/api/admin/catalog-image', { method: 'POST', body: fd })
            .then(function (r) { return r.ok ? r.json() : r.json().then(function (j) { throw new Error(j.error || 'Error'); }); })
            .then(function (d) {
              // Prefiere URL de Cloudinary (persiste en prod); si no, ruta local (dev).
              var src = d.cloudUrl || ((curIdx === 0 ? '/images/catalogos/' : '/images/' + (imgFolder || 'stretch') + '/') + d.filename);
              if (curIdx === 0) editData.coverImg = src; else editData.fichas[curIdx - 1].img = src;
              var imgEl = curBound ? curBound.querySelector('img') : null;
              if (imgEl) imgEl.src = /^https?:\/\//.test(src) ? src : src + '?t=' + Date.now();
              edCommit();
              var donde = d.cloudUrl ? (d.localOk ? 'Cloudinary + local' : 'Cloudinary') : (d.localOk ? 'local' : 'subida');
              if (edFields.msg) { edFields.msg.style.color = '#9CA3AF'; edFields.msg.textContent = 'Guardando...'; }
