---
// src/pages/[lang]/cuerdas.astro

import "../../styles/cuerdas.css"; 
export const prerender = true;  // ← AGREGAR ESTA LÍNEA
import BaseLayout from "../../layouts/BaseLayout.astro";
import BuyButton from "../../components/BuyButton.astro";
import Footer from "../../components/Footer.astro";
import ProductTitle from "../../components/ProductTitle.astro";
import ProductTutorial from "../../components/ProductTutorial.astro";
import { languages, translations } from "../../i18n";
import { getRelatedProducts, LOCALITY_TAG_TEXT, RELATED_PRODUCTS_HEADING } from "../../lib/catalogs.js";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = (lang && lang in translations) ? lang : 'es';
const t = translations[currentLang as keyof typeof translations] as any;
const pageData = t.cuerdas;
const productsList = pageData.products; 
const firstProduct = productsList[0];
const specsLabels = pageData.specs_labels;

const specs = [
  { label: specsLabels.load,   id: "spec-load",   tag: firstProduct.specs_values.load },
  { label: specsLabels.mat,    id: "spec-mat",    tag: firstProduct.specs_values.mat },
  { label: specsLabels.weight, id: "spec-weight", tag: firstProduct.specs_values.weight },
  { label: specsLabels.resist, id: "spec-resist", tag: firstProduct.specs_values.resist },
  { label: specsLabels.charge, id: "spec-charge", tag: firstProduct.specs_values.charge },
];

const relatedProducts = getRelatedProducts('cuerdas', currentLang);
const localityTag = LOCALITY_TAG_TEXT[currentLang] || LOCALITY_TAG_TEXT.es;
const relatedHeading = RELATED_PRODUCTS_HEADING[currentLang] || RELATED_PRODUCTS_HEADING.es;

const CLOUD = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;
const videoPoster = (src: string) =>
  CLOUD ? `https://res.cloudinary.com/${CLOUD}/video/upload/f_jpg,q_auto,so_0/${src.replace(/^\//, "").replace(/\.mp4$/, "")}.jpg` : '';
const videoSrc = (src: string) =>
  !src || src.startsWith('/') || src.startsWith('http') ? src
  : `https://res.cloudinary.com/${CLOUD}/video/upload/q_auto:best/${src}`;
const localVideo = (src: string) => {
  const file = src.replace(/^GO\/cuerdas\//, '').replace(/\.mp4$/, '');
  return `/videos/cuerdas/${file}.mp4`;
};
---

<BaseLayout
    title={pageData.meta_title}
    description={pageData.meta_description || ""}
    canonicalSlug="cuerdas/"
    currentLang={currentLang}
    moveLogoMobile={true}
>
  <Fragment slot="head">
    {CLOUD && <link rel="preload" as="image" href={videoPoster(firstProduct.video || '')} fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": firstProduct.name,
      "description": firstProduct.description,
      "image": `https://grupo-ortiz.com${firstProduct.img}`,
      "brand": { "@type": "Brand", "name": "Grupo Ortiz" },
      "areaServed": "Morelia, Michoacán, México",
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": t.nav?.home || "Inicio", "item": `https://grupo-ortiz.com/${currentLang}/` },
        { "@type": "ListItem", "position": 2, "name": t.nav?.products || "Productos", "item": `https://grupo-ortiz.com/${currentLang}/productos/` },
        { "@type": "ListItem", "position": 3, "name": firstProduct.name, "item": `https://grupo-ortiz.com/${currentLang}/cuerdas/` },
      ],
    })} />
  </Fragment>

  <div id="wipe-transition" class="wipe-container"></div>

  <div class="video-bg-wrapper">
    {productsList.map((prod: any, index: number) => (
      <video
        class={`video-bg ${index === 0 ? 'visible' : ''}`}
        data-video-index={index}
        src={videoSrc(prod.video || '')}
        data-local-fallback={localVideo(prod.video || '')}
        autoplay muted playsinline
        preload={index === 0 ? 'metadata' : 'none'}
        poster={index === 0 ? videoPoster(prod.video || '') : undefined}
        data-poster-fallback={index === 0 ? prod.img : undefined}
      />
    ))}
    <div class="video-overlay"></div>
  </div>

  <main class="main-container" data-products={JSON.stringify(productsList)}>

    <div class="content">
      <a href={`/${currentLang}/productos`} class="back-arrow-btn2" id="btn-regresar" aria-label={pageData.back_aria}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12 19 5 12 12 5" />
        </svg>
      </a>
    
      <div class="text-area" style="max-width: 550px; align-items: flex-start;">
        <ProductTitle as="h1" id="product-title" nombre={firstProduct.name} reveal={false} className="fade-in-text anim-text" />
        <p class="product-locality fade-in-text anim-text">{localityTag}</p>
        <p id="product-desc" class="fade-in-text anim-text" style="text-align: left; width: 100%; line-height: 1.5;">
          {firstProduct.description}
        </p>

        <div class="specs-container fade-in-text anim-text" style="text-align: left; width: 100%;">
          <h3 class="specs-title">{pageData.specs_title}</h3>
          <div class="specs-grid">
            {specs.map((spec) => (
              <div class="spec-box">
                <span class="spec-label">{spec.label}</span>
                <span class="spec-value" id={spec.id}>{spec.tag}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="related-products fade-in-text anim-text">
          <h3 class="related-products-title">{relatedHeading}</h3>
          <div class="related-products-list">
            {relatedProducts.map((rp) => (
              <a class="related-products-link" href={`/${currentLang}/${rp.slug}`}>{rp.label}</a>
            ))}
          </div>
        </div>

        <div class="fade-in-text w-full flex justify-center lg:justify-start">
          <BuyButton text={t.common.buy || 'Comprar'} redirecting={t.common.redirecting || 'Redirigiendo...'} />
        </div>
      </div>

      <!-- ✅ MINIATURAS: data-index en cada item para el JS -->
      <div class="thumbnails fade-in-text" id="thumbnails-container">
        {productsList.map((prod: any, index: number) => (
          <div 
            class={`thumb-item ${index === 0 ? 'active' : ''}`} 
            data-index={String(index)}
            role="button"
            tabindex="0"
            aria-label={prod.name}
          >
            <img src={prod.img} alt={prod.name} loading="lazy" decoding="async" width="60" height="60"/>
          </div>
        ))}
      </div>
    </div>

    <div class="wheel-container">
      <div class="wheel" id="product-wheel" style="position: relative;">

        <div class="product-image-overlay" id="product-image-overlay">
          <img 
            id="product-hero-img"
            class="product-hero-img"
            src={firstProduct.img}
            alt={`${firstProduct.name} en Morelia, Michoacán`}
          />
        </div>

        <div class="product-gallery" id="product-gallery">
          {productsList.map((prod: any, index: number) => (
            <div class={`gallery-strip ${index === 0 ? 'active' : ''}`} data-gallery-index={index}>
              {(prod.gallery || [prod.img, prod.img, prod.img]).map((imgSrc: string, imgIdx: number) => (
                <div class="gallery-photo" data-img-index={imgIdx + 1}>
                  <img 
                    src={imgSrc} 
                    alt={`${prod.name} vista ${imgIdx + 1}`} 
                    loading="lazy" 
                    decoding="async" 
                  />
                  <div class="gallery-photo-glow"></div>
                </div>
              ))}
            </div>
          ))}
        </div>

      </div>
    </div>

  </main>

  <script is:inline>
  // ═══════════════════════════════════════════════════════════════
  // LÓGICA PRINCIPAL — cuerdas.astro
  // FIX MÓVIL: touchend en miniaturas para cambiar producto
  // ═══════════════════════════════════════════════════════════════
  function initCuerdasLogic() {
    const container = document.querySelector('.main-container');
    if (!container) return;

    const products = JSON.parse(container.dataset.products || '[]');
    
    const titleEl = document.getElementById('product-title');
    const descEl  = document.getElementById('product-desc');
    const heroImg = document.getElementById('product-hero-img');
    const overlay = document.getElementById('product-image-overlay');

    // ── Lógica de la Lupa (Magnifier) ─────────────────────────────
    let lens;
    function initMagnifier() {
      if (!heroImg || !overlay || window.innerWidth <= 1024) return;
      
      if (!lens) {
        lens = document.createElement('div');
        lens.className = 'magnifier-lens';
        overlay.appendChild(lens);
      }

      function moveLens(e) {
        const rect = heroImg.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        if (x > 0 && x < rect.width && y > 0 && y < rect.height) {
          lens.classList.add('visible');
          const overlayRect = overlay.getBoundingClientRect();
          const lensX = e.clientX - overlayRect.left - (lens.offsetWidth / 2);
          const lensY = e.clientY - overlayRect.top - (lens.offsetHeight / 2);
          lens.style.left = lensX + 'px';
          lens.style.top  = lensY + 'px';

          const zoom = 2.5; 
          lens.style.backgroundImage = `url('${heroImg.src}')`;
          lens.style.backgroundSize  = (rect.width * zoom) + 'px ' + (rect.height * zoom) + 'px';
          const bgX = (x * zoom) - (lens.offsetWidth / 2);
          const bgY = (y * zoom) - (lens.offsetHeight / 2);
          lens.style.backgroundPosition = `-${bgX}px -${bgY}px`;
        } else {
          lens.classList.remove('visible');
        }
      }
      overlay.addEventListener('mousemove', moveLens);
      overlay.addEventListener('mouseleave', () => {
        if (lens) lens.classList.remove('visible');
      });
    }
    initMagnifier();

    const specIds = {
      load:   document.getElementById('spec-load'),
      unit:   document.getElementById('spec-unit'),
      mat:    document.getElementById('spec-mat'),
      weight: document.getElementById('spec-weight'),
      resist: document.getElementById('spec-resist'),
      charge: document.getElementById('spec-charge'),
    };

    // ── Actualizar textos con animación ──────────────────────────
    function updateContent(idx) {
      const product = products[idx];
      if (!product) return;
      const anims = document.querySelectorAll('.anim-text');
      const applyText = () => {
        if (titleEl) titleEl.textContent = product.name;
        if (descEl)  descEl.textContent  = product.description;
        if (product.specs_values) {
          if (specIds.load)   specIds.load.textContent   = product.specs_values.load   || '';
          if (specIds.unit)   specIds.unit.textContent   = product.specs_values.unit   || '';
          if (specIds.mat)    specIds.mat.textContent    = product.specs_values.mat    || '';
          if (specIds.weight) specIds.weight.textContent = product.specs_values.weight || '';
          if (specIds.resist) specIds.resist.textContent = product.specs_values.resist || '';
          if (specIds.charge) specIds.charge.textContent = product.specs_values.charge || '';
        }
      };
      // CSS keyframe fade — no GSAP needed
      anims.forEach(el => { el.classList.remove('js-animating'); el.style.opacity = '0'; });
      setTimeout(() => {
        applyText();
        anims.forEach(el => { el.style.opacity = ''; el.classList.add('js-animating'); });
        setTimeout(() => anims.forEach(el => el.classList.remove('js-animating')), 350);
      }, 200);
    }

    // ── Actualizar video ─────────────────────────────────────────
 function updateVideo(idx) {
  document.querySelectorAll('.video-bg').forEach((vid, i) => {
    if (i === idx) {
      vid.classList.add('visible');
      vid.currentTime = 0;          // ← reinicia al seleccionar
      vid.play().catch(() => {});

      // Congelar en el último fotograma al terminar
      vid.onended = () => {
        vid.pause();
        // currentTime ligeramente antes del final para evitar pantalla negra en algunos navegadores
        vid.currentTime = vid.duration - 0.001;
      };
    } else {
      vid.classList.remove('visible');
      vid.pause();
      vid.onended = null;           // ← limpiar listener en videos inactivos
    }
  });
}

    // ── Actualizar galería ───────────────────────────────────────
    function updateGallery(idx) {
      document.querySelectorAll('.gallery-strip').forEach((strip, i) => {
        strip.classList.toggle('active', i === idx);
      });
    }

    // ── Función central: cambiar producto ────────────────────────
    function selectProduct(idx) {
      const thumbs = document.querySelectorAll('.thumb-item');
      // Evitar re-seleccionar el mismo
      if (thumbs[idx] && thumbs[idx].classList.contains('active')) return;

      // Actualizar estado activo
      thumbs.forEach(t => t.classList.remove('active'));
      if (thumbs[idx]) thumbs[idx].classList.add('active');

      // Actualizar imagen principal
      if (heroImg && products[idx] && products[idx].img) {
        heroImg.src = products[idx].img;
        heroImg.alt = (products[idx].name || '') + ' en Morelia, Michoacán';
      }

      updateContent(idx);
      updateVideo(idx);
      updateGallery(idx);
    }

    // ════════════════════════════════════════════════════════════
    // ✅ LISTENERS MINIATURAS — FIX CRÍTICO PARA MÓVIL
    //
    // PROBLEMA ORIGINAL: Solo había listener de 'click'.
    // En móvil, el navegador espera 300ms antes de disparar click
    // y cualquier touchstart/touchmove en un padre puede cancelarlo.
    //
    // SOLUCIÓN: Escuchar 'touchend' directamente en el thumb con
    // stopPropagation + preventDefault para cortar la cadena.
    // ════════════════════════════════════════════════════════════
    const selectedSet = new Set();
    let isMultiMode = false;

    function updateFab() {
      const n = selectedSet.size;
      const fab = document.getElementById('mst-fab');
      const fabCount = document.getElementById('mst-fab-count');
      const fabLabel = document.getElementById('mst-fab-label');
      if (fab) {
        if (fabCount) fabCount.textContent = n;
        if (fabLabel) fabLabel.textContent = n === 1 ? 'seleccionado' : 'seleccionados';
        if (n > 0) fab.classList.add('mst-fab-visible');
        else       fab.classList.remove('mst-fab-visible');
        const buyBtn = document.getElementById('truck-cta-btn');
        if (buyBtn) {
          if (n > 0 && window.innerWidth <= 768) buyBtn.style.display = 'none';
          else buyBtn.style.display = '';
        }
      }
      if (n === 0) isMultiMode = false;
    }

    function applySelection(idx) {
      const thumb = document.querySelector('.thumb-item[data-index="' + idx + '"]');
      if (!thumb) return;
      if (selectedSet.has(idx)) {
        selectedSet.delete(idx);
        thumb.classList.remove('selected');
      } else {
        selectedSet.add(idx);
        thumb.classList.add('selected');
        thumb.classList.remove('thumb-mobile-hidden');
      }
      if (navigator.vibrate) navigator.vibrate(30);
      updateFab();
      if (selectedSet.size === 0) isMultiMode = false;
    }

    const thumbs = document.querySelectorAll('.thumb-item');

    thumbs.forEach((thumb) => {
      const idx = parseInt(thumb.dataset.index, 10);
      if (isNaN(idx)) return;

      // ── Long press desktop ──────────────────────────────
      let mouseTimer = null, didMouseLong = false;
      thumb.addEventListener('mousedown', function(e) {
        if (e.button !== 0) return;
        didMouseLong = false;
        mouseTimer = setTimeout(function() {
          didMouseLong = true;
          if (!isMultiMode) { isMultiMode = true; }
          applySelection(idx);
        }, 450);
      });
      thumb.addEventListener('mouseup', function() { clearTimeout(mouseTimer); });
      thumb.addEventListener('mouseleave', function() { clearTimeout(mouseTimer); });

      // ── Long press touch ────────────────────────────────
      let pressTimer = null, didLongPress = false;
      thumb.addEventListener('touchstart', function(e) {
        e.stopPropagation();
        didLongPress = false;
        thumb.classList.add('pressing');
        pressTimer = setTimeout(function() {
          didLongPress = true;
          thumb.classList.remove('pressing');
          if (!isMultiMode) { isMultiMode = true; }
          applySelection(idx);
        }, 450);
      }, { passive: true });
      thumb.addEventListener('touchmove', function() {
        clearTimeout(pressTimer);
        thumb.classList.remove('pressing');
        didLongPress = false;
      }, { passive: true });
      thumb.addEventListener('touchend', function(e) {
        clearTimeout(pressTimer);
        thumb.classList.remove('pressing');
        if (didLongPress) { didLongPress = false; return; }
        e.preventDefault();
        if (isMultiMode) { applySelection(idx); return; }
        selectProduct(idx);
      }, { passive: false });

      // ── Click desktop ───────────────────────────────────
      thumb.addEventListener('click', function(e) {
        if (didMouseLong) { didMouseLong = false; return; }
        if (isMultiMode) { applySelection(idx); return; }
        selectProduct(idx);
      });

      // ── keydown: accesibilidad (Enter / Space)
      thumb.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (isMultiMode) { applySelection(idx); return; }
          selectProduct(idx);
        }
      });
    });

    const fabCta = document.getElementById('mst-fab-cta');
    if (fabCta) {
      fabCta.addEventListener('click', function() {
        if (selectedSet.size === 0) return;
        let msg = 'Hola! Me interesa cotizar los siguientes productos de Cuerdas:\n\n';
        let i = 1;
        selectedSet.forEach(function(idx) {
          const p = products[idx];
          if (p) { msg += i + '. *' + (p.name || p.label || 'Producto ' + idx) + '*\n'; i++; }
        });
        msg += '\n\xBFPodr\xEDan darme m\xE1s informaci\xF3n y precios?';
        const url = 'https://wa.me/5214432072593?text=' + encodeURIComponent(msg);
        if (window.__arpiAnimateFlyToBtn) {
          window.__arpiAnimateFlyToBtn(selectedSet, fabCta, function() { window.open(url, '_blank'); });
        } else {
          window.open(url, '_blank');
        }
      });
    }

    // ── Drag para expandir tarjeta en móvil ─────────────────────
    const textArea = document.querySelector('.text-area');
    if (textArea && window.innerWidth <= 1024) {
      let startY    = 0;
      let isDragging = false;

      textArea.addEventListener('touchstart', function(e) {
        // ✅ NO interferir con las miniaturas
        if (e.target.closest('.thumb-item') || e.target.closest('#thumbnails-container')) return;

        const touch = e.touches[0];
        const rect  = textArea.getBoundingClientRect();
        // Solo activar drag en la zona del handle (primeros 60px)
        if (touch.clientY - rect.top > 60) return;

        startY     = touch.clientY;
        isDragging = true;
      }, { passive: true });

      textArea.addEventListener('touchend', function(e) {
        // ✅ NO interferir con las miniaturas
        if (e.target.closest('.thumb-item') || e.target.closest('#thumbnails-container')) return;
        if (!isDragging || !startY) return;

        const endY = e.changedTouches[0].clientY;
        const diff = startY - endY;

        if (diff > 40)       textArea.classList.add('expanded');
        else if (diff < -40) textArea.classList.remove('expanded');

        startY     = 0;
        isDragging = false;
      }, { passive: true });
    }

    // ── Fotos de la galería ──────────────────────────────────────
    document.querySelectorAll('.gallery-photo').forEach((photo) => {
      const activate = () => {
        const clickedImg = photo.querySelector('img');
        if (heroImg && clickedImg) heroImg.src = clickedImg.src;
      };

      photo.addEventListener('touchend', function(e) {
        e.stopPropagation();
        e.preventDefault();
        activate();
      }, { passive: false });

      photo.addEventListener('click', function(e) {
        e.stopPropagation();
        activate();
      });
    });
  }

  // Iniciar en todos los ciclos de vida de Astro
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCuerdasLogic);
  } else {
    initCuerdasLogic();
  }
  document.addEventListener("astro:page-load",  initCuerdasLogic);
  document.addEventListener("astro:after-swap", initCuerdasLogic);
  </script>

  <script is:inline>
  // ═══════════════════════════════════════════════════════════════
  // TRANSICIÓN WIPE
  // ═══════════════════════════════════════════════════════════════
  function initTransition() {
    const wipe = document.getElementById("wipe-transition");
    const btn  = document.getElementById("btn-regresar");
    if (!wipe || !btn) return;
    
    wipe.classList.remove("active");
    
    // Clonar para limpiar listeners anteriores
    const newBtn = btn.cloneNode(true);
    btn.parentNode.replaceChild(newBtn, btn);

    newBtn.addEventListener("click", (e) => {
      e.preventDefault(); 
      const url = newBtn.getAttribute("href");
      const isDark = document.documentElement.classList.contains('dark') || 
                     document.body.classList.contains('dark');
      wipe.style.setProperty('--reveal-bg', isDark ? "#262626" : "#ffffff");
      wipe.classList.add("active"); 
      setTimeout(() => { window.location.href = url; }, 600); 
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTransition);
  } else {
    initTransition();
  }
  document.addEventListener("astro:page-load",  initTransition);
  document.addEventListener("astro:after-swap", initTransition);
  </script>



  <ProductTutorial />
  <Footer currentLang={currentLang} />
</BaseLayout>