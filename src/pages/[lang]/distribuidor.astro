---
// src/pages/[lang]/distribuidor.astro
import "../../styles/distribuidor.css";
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import { languages, translations } from "../../i18n";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang && lang in translations ? lang : "es";
const t = translations[currentLang as keyof typeof translations] as any;

const pageData = t.distribuidor || {};

const defaultCards = [
  {
    icon: "ri-stack-line",
    title: "Stock Total",
    desc: "Capacidad para surtir grandes pedidos al instante.",
  },
  {
    icon: "ri-truck-line",
    title: "Envíos 24h",
    desc: "Logística propia. Entregamos en tiempo récord.",
  },
  {
    icon: "ri-shield-check-line",
    title: "Garantía",
    desc: "Cambios físicos sin burocracia ni preguntas.",
  },
  {
    icon: "ri-line-chart-line",
    title: "Mejor Margen",
    desc: "Precios directos de fábrica.",
  },
];

const features =
  pageData.cards && Array.isArray(pageData.cards) && pageData.cards.length > 0
    ? pageData.cards
    : defaultCards;

const stats = pageData.stats || [{ val: 0, symbol: "+", label: "Cargando..." }];

/* Progress bar widths per stat — maps to visual proportion */
const statBarWidths = ["75%", "85%", "65%"];

const form = pageData.form || {
  title: "Solicitud",
  desc: "Contáctanos",
  support_label: "SOPORTE",
  labels: {
    name: "Nombre",
    business: "Empresa",
    whatsapp: "Tel",
    email: "Email",
    products: "Productos",
  },
  products_list: ["General"],
  btn: "Enviar",
  success_msg: "Enviado",
};

const heroSubtitle = pageData.hero?.subtitle || "Portal Mayoristas";
const heroTitle    = pageData.hero?.title || "Multiplica tus Ingresos";
const heroDesc     = pageData.hero?.desc || "Distribuye productos de alta demanda.";
const heroCta      = pageData.hero?.cta || "Comenzar";
const metaTitle    = pageData.meta_title || "Distribuidor";
const metaDesc     = pageData.meta_description || "";

const placeholderImg =
  "https://placehold.co/600x900/111/fb670b?text=App+Distribuidor&font=roboto";

// Textos del overlay (carga / error) por idioma.
const sendingMsg = currentLang === 'en' ? 'Sending...'
  : currentLang === 'pt' ? 'Enviando...'
  : currentLang === 'ar' ? 'جار الإرسال...'
  : currentLang === 'zh' ? '提交中...'
  : 'Enviando...';
const errorMsg = currentLang === 'en' ? 'Could not send. Please try again.'
  : currentLang === 'pt' ? 'Não foi possível enviar. Tente novamente.'
  : currentLang === 'ar' ? 'تعذر الإرسال. حاول مرة أخرى.'
  : currentLang === 'zh' ? '发送失败，请重试。'
  : 'No se pudo enviar. Intenta de nuevo.';
const optionalLabel = currentLang === 'en' ? 'optional'
  : currentLang === 'pt' ? 'opcional'
  : currentLang === 'ar' ? 'اختياري'
  : currentLang === 'zh' ? '选填'
  : 'opcional';
const contactRequiredMsg = currentLang === 'en' ? 'Enter a WhatsApp number or an email address.'
  : currentLang === 'pt' ? 'Informe um número de WhatsApp ou um e-mail.'
  : currentLang === 'ar' ? 'أدخل رقم واتساب أو بريداً إلكترونياً.'
  : currentLang === 'zh' ? '请填写 WhatsApp 号码或电子邮箱。'
  : 'Ingresa un número de WhatsApp o un correo electrónico.';
const emailInvalidMsg = currentLang === 'en' ? 'Enter a valid email address.'
  : currentLang === 'pt' ? 'Informe um e-mail válido.'
  : currentLang === 'ar' ? 'أدخل بريداً إلكترونياً صحيحاً.'
  : currentLang === 'zh' ? '请输入有效的电子邮箱。'
  : 'Ingresa un correo electrónico válido.';
const successSub = currentLang === 'en' ? 'We received your info. We will contact you soon.'
  : currentLang === 'pt' ? 'Recebemos seus dados. Entraremos em contato em breve.'
  : currentLang === 'ar' ? 'تم استلام بياناتك. سنتواصل معك قريبا.'
  : currentLang === 'zh' ? '我们已收到您的信息，会尽快与您联系。'
  : 'Recibimos tus datos. Pronto nos pondremos en contacto contigo.';
const subscribeLabel = currentLang === 'en' ? 'I want to receive news about products and exclusive content by email'
  : currentLang === 'pt' ? 'Quero receber novidades sobre produtos e conteúdo exclusivo por e-mail'
  : currentLang === 'ar' ? 'أريد تلقي أخبار المنتجات والمحتوى الحصري عبر البريد الإلكتروني'
  : currentLang === 'zh' ? '我想通过电子邮件接收产品资讯和独家内容'
  : 'Quiero recibir novedades de productos y contenido exclusivo por correo';
---

<BaseLayout title={metaTitle} description={metaDesc} canonicalSlug="distribuidor/" currentLang={currentLang}>

  <!-- ── HEAD: íconos cargados sin bloquear render ── -->
  <Fragment slot="head">
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <!-- Non-blocking CSS load: media=print switches to all on load, zero render-blocking -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" />
    </noscript>
    <!-- Montserrat ExtraBold — solo para el overlay de confirmacion (no bloqueante) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&display=swap" />
    </noscript>
  </Fragment>

  <!-- Efecto de revelación al enviar formulario -->
  <div class="reveal-container" id="revealEffect" role="status" aria-live="polite">
    <div class="reveal-bg"></div>
    <div class="reveal-card">
      <div class="reveal-icon">
        <div class="reveal-spinner" id="revealSpinner" aria-hidden="true"></div>
        <svg class="reveal-check" viewBox="0 0 52 52" aria-hidden="true">
          <circle class="reveal-check-circle" cx="26" cy="26" r="23" fill="none"/>
          <path class="reveal-check-mark" fill="none" d="M15 27 l7 7 l15 -15"/>
        </svg>
      </div>
      <div
        class="reveal-text"
        id="revealText"
        data-success={form.success_msg}
        data-sending={sendingMsg}
        data-error={errorMsg}
        data-contact-required={contactRequiredMsg}
        data-email-invalid={emailInvalidMsg}
      >{form.success_msg}</div>
      <p class="reveal-sub" id="revealSub" data-sub={successSub}></p>
    </div>
  </div>

  <!-- Canvas de fondo con partículas Three.js -->
  <div id="canvas-bg" aria-hidden="true"></div>

  <div class="distribuidor-container">

    <!-- Hero Section -->
    <section class="hero-split">
      <div class="hero-content">
        <h4 class="gs-fade">{heroSubtitle}</h4>
        <h1 class="gs-title" set:html={heroTitle} />
        <p class="gs-fade">{heroDesc}</p>
        <a href="#formulario" class="btn-cta gs-fade">
          {heroCta}
          <i class="ri-arrow-right-line"></i>
        </a>
      </div>
      <div class="hero-visual">
        <img
          src="/assets/cel.png"
          alt="Aplicación de distribuidor"
          class="hero-img gs-img"
          onerror={`this.src='${placeholderImg}'`}
          loading="eager"
        />
      </div>
    </section>

    <!-- Section Divider -->
    <div class="section-divider" aria-hidden="true">
      <div class="section-divider-dot"></div>
    </div>

    <!-- Features Grid -->
    <div class="grid-features">
      {
        features.map((card: any, index: number) => (
          <div
            class="card js-tilt"
            data-tilt
            data-num={String(index + 1).padStart(2, "0")}
          >
            <div class="card-header">
              <div class="card-icon-wrap">
                <i class={card.icon} />
              </div>
              <h3>{card.title}</h3>
            </div>
            <p>{card.desc}</p>
          </div>
        ))
      }
    </div>

    <!-- Dots carrusel (móvil) -->
    <div class="carousel-dots" id="cardsDots"></div>

    <!-- Stats Section -->
    <div class="stats-row in-view" id="statsRow">
      {
        stats.map((stat: any, index: number) => (
          <div class="stat-box">
            <div class="stat-number">
              <span class="stat-val">{stat.val}</span>
              <span class="stat-symbol">{stat.symbol}</span>
            </div>
            <div class="stat-label">{stat.label}</div>
            <div class="stat-bar-wrap">
              <div
                class="stat-bar"
                style={`--bar-width: ${statBarWidths[index] ?? "70%"}`}
              ></div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Form Section -->
    <section id="formulario" class="form-section gs-reveal">
      <div class="form-cta">
        <h2 set:html={form.title} />
        <p>{form.desc}</p>

        <div class="support-info">
          <strong class="support-label">{form.support_label}</strong>
          <span class="support-number">
            <i class="ri-whatsapp-line"></i> 443 207 2593
          </span>
        </div>
      </div>

      <div class="form-inputs">
        <form id="distribuidor-form">
          <div class="input-row">
            <div class="field-group">
              <label for="name">{form.labels.name}</label>
              <input type="text" id="name" name="name" required autocomplete="name" />
            </div>
            <div class="field-group">
              <label for="business">{form.labels.business} <span class="optional-tag">({optionalLabel})</span></label>
              <input type="text" id="business" name="business" autocomplete="organization" />
            </div>
          </div>
          <div class="input-row">
            <div class="field-group">
              <label for="whatsapp">{form.labels.whatsapp}</label>
              <input type="tel" id="whatsapp" name="whatsapp" autocomplete="tel" inputmode="tel" pattern="[\d\s\+]{7,}" title="Solo números (puede incluir + de código de país)" />
            </div>
            <div class="field-group">
              <label for="email">{form.labels.email}</label>
              <input type="email" id="email" name="email" autocomplete="email" />
            </div>
          </div>

          <div class="field-group products-field">
            <label>{form.labels.products}</label>
            <div class="selection-grid">
              {
                form.products_list &&
                  form.products_list.map((prod: any, index: number) => (
                    <label class="select-btn">
                      <input
                        type="checkbox"
                        name="products"
                        value={prod}
                        checked={index === 0}
                      />
                      <span>{prod}</span>
                    </label>
                  ))
              }
            </div>
          </div>

          <label class="subscribe-optin">
            <input type="checkbox" id="subscribe" name="subscribe" checked />
            <span>{subscribeLabel}</span>
          </label>

          <button type="submit" class="submit-btn">
            <span>{form.btn}</span>
            <i class="ri-arrow-right-line"></i>
          </button>
        </form>
      </div>
    </section>

  </div><!-- /distribuidor-container -->

  <script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // ─────────────────────────────────────────────────────────────
  // FUNCIÓN PRINCIPAL
  // ─────────────────────────────────────────────────────────────
  function initDistribuidor() {
    // Limpiar instancias anteriores (SPA/View Transitions de Astro)
    ScrollTrigger.getAll().forEach(function (st) { st.kill(); })

    // ── HERO ─────────────────────────────────────────────────────
    var heroTl = gsap.timeline({ defaults: { ease: "power4.out" } });
    heroTl
      .from(".gs-title", { y: 80, opacity: 0, duration: 1.2, filter: "blur(8px)" })
      .from(".gs-fade",  { y: 30,  opacity: 0, duration: 0.8, stagger: 0.18 }, "-=0.7")
      .from(".gs-img",   { scale: 0.88, opacity: 0, duration: 1.5, ease: "power2.out", filter: "blur(4px)" }, "-=1");

    // ── SECTION DIVIDER ──────────────────────────────────────────
    var divider = document.querySelector(".section-divider");
    if (divider) {
      gsap.from(divider, {
        opacity: 0,
        scaleX: 0.4,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: divider,
          start: "top 92%",
          toggleActions: "play none none none",
        },
      });
    }

    // ── CARDS ─────────────────────────────────────────────────────
    var cards = document.querySelectorAll(".card");
    if (cards.length > 0) {
      gsap.fromTo(
        cards,
        { y: 70, autoAlpha: 0, scale: 0.94, filter: "blur(6px)" },
        {
          y: 0, autoAlpha: 1, scale: 1, filter: "blur(0px)",
          duration: 0.85,
          stagger: { amount: 0.45, from: "start" },
          ease: "back.out(1.5)",
          scrollTrigger: {
            trigger: ".grid-features",
            start: "top 88%",
            toggleActions: "play none none none",
          },
        }
      );
    }

    // stats se renderizan directo en HTML — sin JS necesario

    // ── FORM REVEAL — GSAP solo para el formulario (sin contadores) ─
    var formSection = document.querySelector('.form-section');
    if (formSection) {
      gsap.set(formSection, { autoAlpha: 0, y: 50 });
      var formIO = new IntersectionObserver(function (entries, obs) {
        if (!entries[0].isIntersecting) return;
        obs.disconnect();
        gsap.to(formSection, { autoAlpha: 1, y: 0, duration: 1.2, ease: 'power3.out' });
      }, { threshold: 0.05 });
      formIO.observe(formSection);
    }

    // ── THREE.JS PARTICLES (lazy — solo desktop)
    if (window.innerWidth > 768) {
      import('three').then(function(m) { initThreeJSBackground(m); });
    }

    // ── VANILLA TILT (lazy)
    import('vanilla-tilt').then(function(m) {
      var VanillaTilt = m.default || m;
      var tiltEls = document.querySelectorAll(".js-tilt");
      if (tiltEls.length) {
        VanillaTilt.init(tiltEls, {
          max: 8, speed: 400, glare: true, "max-glare": 0.12, scale: 1.03,
        });
      }
    });

    // ── CAROUSEL DOTS (móvil) ────────────────────────────────────
    setupCarouselDots();

    // ── FORM ─────────────────────────────────────────────────────
    setupFormSubmission();
  }

  // ─────────────────────────────────────────────────────────────
  // THREE.JS BACKGROUND
  // ─────────────────────────────────────────────────────────────
  function initThreeJSBackground(m) {
    var THREE = m.default || m;
    var container = document.getElementById("canvas-bg");
    if (!container) return;
    container.innerHTML = "";

    var scene  = new THREE.Scene();
    var camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 40;

    var renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    var geo       = new THREE.BufferGeometry();
    var count     = 600;
    var positions = new Float32Array(count * 3);
    for (var i = 0; i < count * 3; i++) { positions[i] = (Math.random() - 0.5) * 120; }
    geo.setAttribute("position", new THREE.BufferAttribute(positions, 3));

    var mat = new THREE.PointsMaterial({
      size: 0.15, color: 0xfb670b, transparent: true, opacity: 0.6, sizeAttenuation: true,
    });

    var particles = new THREE.Points(geo, mat);
    scene.add(particles);

    var rafId;
    function animate() {
      if (!document.getElementById("canvas-bg")) { cancelAnimationFrame(rafId); return; }
      rafId = requestAnimationFrame(animate);
      particles.rotation.y += 0.0008;
      particles.rotation.x -= 0.0005;
      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener("resize", function () {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  }

  // ─────────────────────────────────────────────────────────────
  // CAROUSEL DOTS
  // ─────────────────────────────────────────────────────────────
  function setupCarouselDots() {
    var grid = document.querySelector(".grid-features");
    var dotsContainer = document.getElementById("cardsDots");
    if (!grid || !dotsContainer) return;

    var cards = grid.querySelectorAll(".card");
    if (!cards.length) return;

    dotsContainer.innerHTML = "";
    cards.forEach(function (_, i) {
      var dot = document.createElement("button");
      dot.className = "carousel-dot" + (i === 0 ? " active" : "");
      dot.setAttribute("aria-label", "Ir a card " + (i + 1));
      dot.addEventListener("click", function () {
        cards[i].scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" });
      });
      dotsContainer.appendChild(dot);
    });

    grid.addEventListener("scroll", function () {
      var scrollLeft = grid.scrollLeft;
      var cardWidth  = cards[0].offsetWidth + 14; // gap
      var active     = Math.round(scrollLeft / cardWidth);
      dotsContainer.querySelectorAll(".carousel-dot").forEach(function (dot, i) {
        dot.classList.toggle("active", i === active);
      });
    }, { passive: true });
  }

  // ─────────────────────────────────────────────────────────────
  // FORM SUBMISSION
  // ─────────────────────────────────────────────────────────────
  function setupFormSubmission() {
    var formEl = document.getElementById("distribuidor-form");
    var reveal = document.getElementById("revealEffect");
    if (!formEl || !reveal) return;

    // Clonar para eliminar listeners anteriores (evita doble submit en SPA)
    var newForm = formEl.cloneNode(true);
    formEl.parentNode.replaceChild(newForm, formEl);

    // Quita el marcado rojo en cuanto el usuario empieza a corregir.
    // Si al menos uno de los dos (WhatsApp o correo) ya tiene contenido,
    // el requisito "al menos uno" se cumple y se limpian AMBOS campos.
    var emailElEarly = newForm.querySelector('[name="email"]');
    function clearFieldError(el) {
      var group = el.closest(".field-group");
      if (group) group.classList.remove("field-error");
    }
    function onContactInput() {
      var wVal = whatsappEl ? whatsappEl.value.trim() : "";
      var eVal = emailElEarly ? emailElEarly.value.trim() : "";
      if (wVal || eVal) {
        if (whatsappEl)    clearFieldError(whatsappEl);
        if (emailElEarly)  clearFieldError(emailElEarly);
      }
    }
    if (emailElEarly) emailElEarly.addEventListener("input", onContactInput);

    // WhatsApp/Tel: solo numeros — permite "+" de codigo de pais SOLO al inicio
    // (funciona para cualquier pais: +52, +1, +34, +55, etc.)
    var whatsappEl = newForm.querySelector('[name="whatsapp"]');
    if (whatsappEl) {
      whatsappEl.addEventListener("input", function (e) {
        var v = e.target.value.replace(/[^\d\s\+]/g, "");
        v = v.replace(/(?!^)\+/g, "");
        e.target.value = v;
        onContactInput();
      });
      whatsappEl.addEventListener("paste", function (e) {
        e.preventDefault();
        var text = (e.clipboardData || window.clipboardData).getData("text");
        var clean = text.replace(/[^\d\s\+]/g, "").replace(/(?!^)\+/g, "");
        var el = e.target;
        var start = el.selectionStart, end = el.selectionEnd;
        el.value = el.value.slice(0, start) + clean + el.value.slice(end);
        el.selectionStart = el.selectionEnd = start + clean.length;
      });
    }

    newForm.addEventListener("submit", async function (e) {
      e.preventDefault();

      var checked = Array.from(newForm.querySelectorAll('input[name="products"]:checked'))
        .map(function (el) { return el.value; })
        .join(", ");

      var subscribeEl = newForm.querySelector('[name="subscribe"]');

      var payload = {
        action   : "lead",
        nombre   : newForm.querySelector('[name="name"]').value,
        empresa  : newForm.querySelector('[name="business"]').value,
        whatsapp : newForm.querySelector('[name="whatsapp"]').value,
        email    : newForm.querySelector('[name="email"]').value,
        productos: checked,
        comentarios: (newForm.querySelector('[name="comentarios"]') ? newForm.querySelector('[name="comentarios"]').value : ''),
        subscribe: subscribeEl ? subscribeEl.checked : false,
        lang     : document.documentElement.lang || 'es',
      };

      var btn  = newForm.querySelector(".submit-btn");
      var txt  = document.getElementById("revealText");
      var sub  = document.getElementById("revealSub");
      var d    = txt ? txt.dataset : {};

      var whatsappGroup = whatsappEl ? whatsappEl.closest(".field-group") : null;
      var emailElNow    = newForm.querySelector('[name="email"]');
      var emailGroup    = emailElNow ? emailElNow.closest(".field-group") : null;
      function clearFieldErrors() {
        if (whatsappGroup) whatsappGroup.classList.remove("field-error");
        if (emailGroup)    emailGroup.classList.remove("field-error");
      }
      clearFieldErrors();

      // 0) Validacion: al menos WhatsApp o correo, y si hay correo, formato valido.
      var emailOk = !payload.email || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.email);
      var contactOk = !!(payload.whatsapp || payload.email);
      if (!contactOk || !emailOk) {
        if (!contactOk) {
          if (whatsappGroup) whatsappGroup.classList.add("field-error");
          if (emailGroup)    emailGroup.classList.add("field-error");
        } else if (!emailOk) {
          if (emailGroup) emailGroup.classList.add("field-error");
        }
        if (txt) txt.textContent = !contactOk ? (d.contactRequired || "Ingresa un número de WhatsApp o un correo electrónico.")
                                               : (d.emailInvalid    || "Ingresa un correo electrónico válido.");
        if (sub) sub.textContent = "";
        reveal.classList.add("active", "error");
        setTimeout(function () { reveal.classList.remove("active", "error"); }, 2800);
        return;
      }

      if (btn) btn.disabled = true;

      // 1) Pantalla de carga
      if (txt) txt.textContent = d.sending || "Enviando...";
      if (sub) sub.textContent = "";
      reveal.classList.remove("error");
      reveal.classList.add("active", "loading");

      // 2) Enviar y VERIFICAR la respuesta (antes mostraba exito aunque fallara)
      var ok = false, msg = "";
      try {
        var res  = await fetch("/api/analytics", {
          method : "POST",
          headers: { "Content-Type": "application/json" },
          body   : JSON.stringify(payload),
        });
        var data = await res.json().catch(function () { return {}; });
        ok  = res.ok && data.ok !== false;
        msg = data.error || "";
      } catch (err) {
        console.warn("Error guardando lead:", err);
      }

      reveal.classList.remove("loading");

      if (ok) {
        // 3a) Exito → "¡Registro exitoso!" + subtitulo de confirmacion
        reveal.classList.remove("error");
        if (txt) txt.textContent = d.success || "¡Registro exitoso!";
        if (sub) sub.textContent = sub.dataset.sub || "Recibimos tus datos. Pronto te contactamos.";
        setTimeout(function () {
          reveal.classList.remove("active");
          newForm.reset();
          if (btn) btn.disabled = false;
        }, 4200);
      } else {
        // 3b) Error → no resetea, deja reintentar
        reveal.classList.add("error");
        if (txt) txt.textContent = msg || d.error || "No se pudo enviar. Intenta de nuevo.";
        if (sub) sub.textContent = "";
        setTimeout(function () {
          reveal.classList.remove("active", "error");
          if (btn) btn.disabled = false;
        }, 2800);
      }
    });
  }

  // ─────────────────────────────────────────────────────────────
  // ARRANQUE — robusto: carga normal (DOMContentLoaded) + SPA si hubiera
  // ViewTransitions (astro:page-load) + bfcache (pageshow).
  // BUG previo: solo escuchaba astro:page-load, que NO dispara sin ViewTransitions
  // → el handler del form nunca se enganchaba → submit GET nativo (recarga sin registro).
  // ─────────────────────────────────────────────────────────────
  function bootDistribuidor() {
    // GSAP en su propio try: si una animacion falla, NO debe tumbar el form.
    try { initDistribuidor(); } catch (e) { console.warn("init distribuidor:", e); }
    // Garantiza el handler del form pase lo que pase (idempotente: clona el form).
    try { setupFormSubmission(); } catch (e) { console.warn("form distribuidor:", e); }
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootDistribuidor, { once: true });
  } else {
    bootDistribuidor();
  }
  document.addEventListener("astro:page-load", bootDistribuidor);
  </script>

  <Footer currentLang={currentLang} />
</BaseLayout>
