---
// src/pages/500.astro — Astro la sirve automaticamente en errores SSR (500).
import MaintenanceScreen from '../components/MaintenanceScreen.astro';
export const prerender = false;

const ruta = (() => { try { return new URL(Astro.request.url).pathname; } catch { return '?'; } })();
// Solo alerta si el error es en una PAGINA publica (lo que ve el visitante).
// Errores en endpoints internos /api/* NO alertan (no afectan la navegacion y
// generaban spam, ej. "error 500 en /api/logs"). Solo se registran en el panel.
const esPaginaPublica = !ruta.startsWith('/api/') && !ruta.startsWith('/stats');
try {
  const { logSystemEvent } = await import('../lib/analytics-db.js');
  await logSystemEvent({ level: esPaginaPublica ? 'critical' : 'warn', category: 'backend', source: ruta, message: `Error 500 en ${ruta}` }).catch(() => {});
  if (esPaginaPublica) {
    const { alertaUrgente } = await import('../lib/alert-center.js');
    // URGENTE, dedup 60 min por ruta. Solo paginas que el cliente no puede ver.
    alertaUrgente(`500:${ruta}`, `*ERROR EN EL SITIO*\nEsta pagina no carga:\n${ruta}\nRevisa de inmediato.`, { ventanaMin: 60 }).catch(() => {});
  }
} catch { /* nunca dejar que el aviso rompa la pagina de error */ }
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <link rel="preload" as="font" type="font/ttf" href="/fonts/Morganite-ExtraBold.ttf" crossorigin />
  <title>Tuvimos un problema · Grupo Ortiz</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <style>*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}</style>
</head>
<body>
  <MaintenanceScreen
    codigo="500"
    titulo="Tuvimos un problema"
    mensaje="Ya estamos trabajando en ello. Intenta de nuevo en un momento."
    accion="inicio"
  />
</body>
</html>
