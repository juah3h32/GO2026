---
// src/pages/500.astro — Astro la sirve automaticamente en errores SSR (500).
import MaintenanceScreen from '../components/MaintenanceScreen.astro';
export const prerender = false;

// Aviso al admin (server-side) con anti-spam por ruta — sin exponer el stack al publico.
const ruta = (() => { try { return new URL(Astro.request.url).pathname; } catch { return '?'; } })();
try {
  const { alertaUrgente } = await import('../lib/alert-center.js');
  const { logSystemEvent } = await import('../lib/analytics-db.js');
  // Categoria 'backend' (no 'crawl') para que checkAndAlert no la re-avise.
  await logSystemEvent({ level: 'critical', category: 'backend', source: ruta, message: `Error 500 (servidor) en ${ruta}` }).catch(() => {});
  // URGENTE con dedup persistente: 1 alerta por ruta cada 30 min.
  alertaUrgente(`500:${ruta}`, `*ERROR EN EL SITIO*\nEl sitio arrojó un error 500 en:\n${ruta}\nRevisa de inmediato.`, { ventanaMin: 30 }).catch(() => {});
} catch { /* nunca dejar que el aviso rompa la pagina de error */ }
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Tuvimos un problema · Grupo Ortiz</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <style>*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}</style>
</head>
<body>
  <MaintenanceScreen
    codigo="500"
    titulo="Tuvimos un problema"
    mensaje="Ya estamos trabajando en ello. Intenta de nuevo en un momento."
    accion="inicio"
  />
</body>
</html>
