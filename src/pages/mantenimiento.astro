---
// src/pages/mantenimiento.astro — pantalla mostrada en modo mantenimiento (503).
import MaintenanceScreen from '../components/MaintenanceScreen.astro';
export const prerender = false;
Astro.response.status = 503;
Astro.response.headers.set('Retry-After', '120');
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Estamos mejorando · Grupo Ortiz</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <style>*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}</style>
</head>
<body>
  <MaintenanceScreen
    codigo="502"
    titulo="Estamos mejorando esta sección"
    mensaje="Volvemos muy pronto. Gracias por tu paciencia."
    accion="inicio"
  />
  <script is:inline>
    // Auto-retorno: revisa cada 8s si ya se reactivo. Cuando la pagina de origen
    // (o todo el sitio) deja de estar en mantenimiento, vuelve sola.
    (function () {
      var origen = '';
      try { origen = sessionStorage.getItem('mnt_origen') || ''; } catch (e) {}
      function slugDe(p) {
        var m = (p || '').match(/^\/(es|en|pt|ar|zh)(?:\/([^\/?#]+))?/);
        return m ? (m[2] || 'home') : null;
      }
      function chequear() {
        fetch('/api/maintenance-status', { cache: 'no-store' })
          .then(function (r) { return r.json(); })
          .then(function (m) {
            if (!m) return;
            var slug = slugDe(origen);
            var sigueAbajo = m.all || (slug && m.slugs && m.slugs.indexOf(slug) >= 0);
            if (!sigueAbajo) {
              // Reactivado → volver a la pagina de origen o al inicio.
              location.replace(origen || '/');
            }
          })
          .catch(function () {});
      }
      setInterval(chequear, 8000);
      setTimeout(chequear, 3000);
    })();
  </script>
</body>
</html>
