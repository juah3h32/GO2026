---
// src/pages/mantenimiento.astro — pantalla mostrada en modo mantenimiento (503).
import MaintenanceScreen from '../components/MaintenanceScreen.astro';
export const prerender = false;
Astro.response.status = 503;
Astro.response.headers.set('Retry-After', '120');
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <link rel="preload" as="font" type="font/ttf" href="/fonts/Morganite-ExtraBold.ttf" crossorigin />
  <title>Estamos mejorando · Grupo Ortiz</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <style>*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}</style>
</head>
<body>
  <MaintenanceScreen
    codigo="502"
    titulo="Estamos mejorando esta sección"
    mensaje="Volvemos en unos momentos. Recarga o vuelve al inicio."
    accion="inicio"
    recargar={true}
    anim={true}
    contador={40}
  />
  <script is:inline>
    // Auto-retorno: revisa cada 8s si ya se reactivo. Cuando la pagina de origen
    // (o todo el sitio) deja de estar en mantenimiento, vuelve sola.
    (function () {
      var origen = '';
      try { origen = sessionStorage.getItem('mnt_origen') || ''; } catch (e) {}
      function slugDe(p) {
        var m = (p || '').match(/^\/(es|en|pt|ar|zh)(?:\/([^\/?#]+))?/);
        return m ? (m[2] || 'home') : null;
      }
      function chequear() {
        // Solo auto-retorna si REALMENTE vino de una pagina en mantenimiento.
        // Si entro directo (sin origen), no redirige aqui: manda el contador.
        if (!origen) return;
        fetch('/api/maintenance-status?t=' + Date.now(), { cache: 'no-store' })
          .then(function (r) { return r.json(); })
          .then(function (m) {
            if (!m) return;
            var slug = slugDe(origen);
            var sigueAbajo = m.all || (slug && m.slugs && m.slugs.indexOf(slug) >= 0);
            if (!sigueAbajo) {
              // La pagina de origen ya se reactivo → volver a ella.
              location.replace(origen);
            }
          })
          .catch(function () {});
      }
      if (origen) { setInterval(chequear, 8000); setTimeout(chequear, 5000); }

      // Cuenta regresiva visible de 40s: al llegar a 0 va al inicio.
      var restante = 40;
      var elNum = document.getElementById('mnt-count-n');
      var tic = setInterval(function () {
        restante--;
        if (elNum) elNum.textContent = restante;
        if (restante <= 0) { clearInterval(tic); location.replace('/'); }
      }, 1000);
    })();
  </script>
</body>
</html>
