---
// src/pages/mantenimiento.astro — pantalla mostrada en modo mantenimiento (503).
import MaintenanceScreen from '../components/MaintenanceScreen.astro';
export const prerender = false;
Astro.response.status = 503;
Astro.response.headers.set('Retry-After', '120');
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content="30" />
  <title>Estamos mejorando · Grupo Ortiz</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <style>*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}</style>
</head>
<body>
  <MaintenanceScreen
    codigo="502"
    titulo="Estamos mejorando esta sección"
    mensaje="Volvemos muy pronto. Gracias por tu paciencia."
    accion="inicio"
  />
</body>
</html>
