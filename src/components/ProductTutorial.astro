    var btnCY = btnRect.top + btnRect.height / 2;
    var total = thumbEls.length;
    var done = 0;

    thumbEls.forEach(function(thumb, i) {
      var rect = thumb.getBoundingClientRect();
      var sz = rect.width;
      var img = thumb.querySelector('img');

      var clone = document.createElement('div');
      clone.style.cssText = 'position:fixed;left:' + rect.left + 'px;top:' + rect.top + 'px;'
        + 'width:' + sz + 'px;height:' + sz + 'px;border-radius:50%;overflow:hidden;'
        + 'z-index:2147483647;pointer-events:none;'
        + 'border:2.5px solid #16bf78;box-shadow:0 0 14px rgba(22,191,120,.7);'
        + 'transition:none;';
      if (img) {
        var ic = document.createElement('img');
        ic.src = img.src;
        ic.style.cssText = 'width:100%;height:100%;object-fit:cover;';
        clone.appendChild(ic);
      }
      document.body.appendChild(clone);

      var delay = i * 55;
      setTimeout(function() {
        var dx = btnCX - (rect.left + sz / 2);
        var dy = btnCY - (rect.top  + sz / 2);
        clone.style.transition = 'transform 0.42s cubic-bezier(0.55,0,0.2,1), opacity 0.38s ease 0.08s';
        clone.style.transform = 'translate(' + dx + 'px,' + dy + 'px) scale(0.18)';
        clone.style.opacity = '0';
      }, delay + 16);

      setTimeout(function() {
        if (clone.parentNode) clone.parentNode.removeChild(clone);
        done++;
        if (done === total) {
          // pulse the button
          var prev = btnEl.style.cssText;
          btnEl.style.transition = 'transform 0.12s ease, box-shadow 0.12s ease';
          btnEl.style.transform = 'scale(1.18)';
          btnEl.style.boxShadow = '0 0 24px rgba(251,103,11,.85)';
          setTimeout(function() {
            btnEl.style.transform = '';
            btnEl.style.boxShadow = '';
            setTimeout(onDone, 80);
          }, 130);
        }
      }, delay + 440);
    });
  };
})();
</script>
