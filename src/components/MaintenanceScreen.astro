---
/*!
 * GO2026 — Sitio Web Oficial de Grupo Ortiz
 * Copyright (c) 2026 JUAN PABLO CORONA CORONA — Desarrollador Web.
 * Pantalla blanca reutilizable para mantenimiento / error 500 / 404.
 */
interface Props {
  codigo?: string;
  titulo?: string;
  mensaje?: string;
  accion?: 'reintentar' | 'inicio' | 'none';
  recargar?: boolean;
  anim?: boolean;
}
const {
  codigo = '502',
  titulo = 'Estamos mejorando esta sección',
  mensaje = 'Volvemos pronto. Gracias por tu paciencia.',
  accion = 'reintentar',
  recargar = false,
  anim = false,
} = Astro.props;
---
<div class={`mnt-wrap${anim ? ' has-anim' : ''}`}>
  <!-- Número gigante de fondo (marca de agua) -->
  <span class="mnt-bgcode" aria-hidden="true">{codigo}</span>

  <!-- Contenido centrado encima -->
  <div class="mnt-box">
    {anim ? (
      <img class="mnt-gif" src="/error-anim.gif" alt="" aria-hidden="true" width="800" height="600" />
    ) : (
      <svg class="mnt-art" viewBox="0 0 24 24" fill="none"
        stroke="#FB670B" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
      </svg>
    )}

    <h1 class="mnt-title">{titulo}</h1>
    <p class="mnt-text">{mensaje}</p>

    <div class="mnt-actions">
      {accion === 'reintentar' && (
        <button class="mnt-btn" onclick="location.reload()">Reintentar</button>
      )}
      {accion === 'inicio' && (
        <a class="mnt-btn" href="/">Ir al inicio</a>
      )}
      {recargar && (
        <button class="mnt-btn mnt-btn-2" onclick="location.reload()">Recargar</button>
      )}
    </div>

    <div class="mnt-brand">Grupo Ortiz</div>
  </div>
</div>

<style>
  @font-face {
    font-family: 'Morganite';
    src: url('/fonts/Morganite-ExtraBold.ttf') format('truetype');
    font-weight: 800;
    font-display: swap;
  }

  .mnt-wrap {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    width: 100%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
  }

  /* Numero gigante de fondo, centrado, detras de todo */
  .mnt-bgcode {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 46vw;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
    color: #F4F4F5;
    z-index: 0;
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
  }

  /* Contenido encima */
  .mnt-box {
    position: relative;
    z-index: 1;
    text-align: center;
    width: 100%;
    max-width: 96vw;
    padding: 24px;
  }
  .mnt-art {
    display: block;
    margin: 0 auto 22px;
    width: clamp(64px, 14vw, 96px);
    height: auto;
    filter: drop-shadow(0 6px 18px rgba(251,103,11,0.25));
    transform-origin: 50% 50%;
    animation: mnt-wrench 2.4s ease-in-out infinite;
  }
  /* Llave "reparando": balanceo suave continuo */
  @keyframes mnt-wrench {
    0%, 100% { transform: rotate(-12deg); }
    50%      { transform: rotate(12deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mnt-art { animation: none; }
  }
  .mnt-gif {
    display: block;
    margin: 0 auto 4px;
    width: clamp(300px, 64vw, 560px);   /* mas grande */
    height: auto;
    mix-blend-mode: multiply;   /* elimina el fondo blanco del gif */
  }
  /* Con animacion, el numero de fondo se atenua para que no choque con el gif */
  .mnt-wrap.has-anim .mnt-bgcode { opacity: 0.45; }
  .mnt-title {
    font-family: 'Morganite', 'Arial Narrow', sans-serif;
    font-size: clamp(28px, 7vw, 64px);
    font-weight: 800;
    text-transform: uppercase;
    color: #18181B;
    margin: 0 auto 14px;
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;       /* todo en una sola linea */
    width: max-content;        /* la caja se ajusta al texto y se centra */
    max-width: 96vw;
  }
  .mnt-text {
    font-size: clamp(14px, 3.5vw, 17px);
    color: #71717A;
    margin: 0 auto 30px;
    max-width: 460px;
    line-height: 1.65;
  }
  .mnt-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .mnt-btn {
    display: inline-block;
    padding: 13px 32px;
    border-radius: 12px;
    border: none;
    background: #FB670B;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(251,103,11,0.30);
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .mnt-btn:hover {
    background: #E25A09;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(251,103,11,0.40);
  }
  /* Boton secundario (Recargar): contorno naranja */
  .mnt-btn-2 {
    background: transparent;
    color: #FB670B;
    border: 2px solid #FB670B;
    box-shadow: none;
  }
  .mnt-btn-2:hover {
    background: rgba(251,103,11,0.08);
    box-shadow: none;
  }
  .mnt-brand {
    margin-top: 40px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C4C4C4;
  }

  @media (max-width: 640px) {
    .mnt-bgcode { font-size: 62vw; }
  }
</style>
