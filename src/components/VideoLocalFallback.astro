---
// VideoLocalFallback.astro
// Cubre <video data-local-fallback="..."> y <video data-poster-fallback="...">
// Si Cloudinary falla (error o timeout), cambia al local automaticamente.
// En produccion (Vercel) public/videos no se despliega (.gitignore) — si
// PUBLIC_VIDEO_FALLBACK_BASE esta seteado, el fallback se sirve desde ahi
// (Vercel Blob) en vez de la ruta local. Ver scripts/upload-videos-to-blob.mjs.
---
<script define:vars={{ BLOB_BASE: import.meta.env.PUBLIC_VIDEO_FALLBACK_BASE || '' }}>
  function resolveFallback(localPath) {
    if (!localPath) return localPath;
    if (!BLOB_BASE) return localPath;
    return BLOB_BASE.replace(/\/$/, '') + localPath;
  }

  function attachLocalFallbacks() {
    // ── Video src fallback ────────────────────────────────────────────────────
    document.querySelectorAll('video[data-local-fallback]').forEach((vid) => {
      if (vid.__localFbAttached) return;
      vid.__localFbAttached = true;
      const local = resolveFallback(vid.dataset.localFallback);
      if (!local) return;

      let switched = false;
      let timer = null;

      function switchToLocal() {
        if (switched) return;
        const cur = vid.currentSrc || vid.getAttribute('src') || '';
        if (cur && (cur.endsWith(local) || cur.includes(local))) return;
        switched = true;
        if (timer) clearTimeout(timer);
        vid.src = local;
        vid.load();
        if (vid.autoplay) vid.play().catch(() => {});
      }

      function startTimer() {
        if (timer || switched) return;
        timer = setTimeout(() => { if (vid.readyState < 2) switchToLocal(); }, 3000);
        vid.addEventListener('canplay', () => { if (timer) clearTimeout(timer); }, { once: true });
        vid.addEventListener('playing', () => { if (timer) clearTimeout(timer); }, { once: true });
      }

      vid.addEventListener('error', switchToLocal, { capture: true });

      // El src puede vivir en el atributo src del <video> o en un <source> hijo
      const hasSrc = () => !!(vid.getAttribute('src') || vid.querySelector('source[src]'));

      // Lazy-loaded videos (data-src) no tienen src todavia — arrancar timer solo cuando se asigne
      if (hasSrc()) {
        startTimer();
      } else {
        const mo = new MutationObserver(() => {
          if (hasSrc()) { mo.disconnect(); startTimer(); }
        });
        mo.observe(vid, { attributes: true, attributeFilter: ['src'], childList: true });
      }
    });

    // ── Video poster fallback ─────────────────────────────────────────────────
    document.querySelectorAll('video[data-poster-fallback]').forEach((vid) => {
      if (vid.__posterFbAttached) return;
      vid.__posterFbAttached = true;
      const local = vid.dataset.posterFallback;
      if (!local || !vid.poster) return;
      // skip if poster is already local
      if (!vid.poster.includes('cloudinary')) return;

      const img = new Image();
      const timer = setTimeout(() => { vid.poster = local; }, 4000);
      img.onload = () => clearTimeout(timer);
      img.onerror = () => { clearTimeout(timer); vid.poster = local; };
      img.src = vid.poster;
    });
  }

  document.addEventListener('DOMContentLoaded', attachLocalFallbacks);
  document.addEventListener('astro:page-load', attachLocalFallbacks);
</script>
