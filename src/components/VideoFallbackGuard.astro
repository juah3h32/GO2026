---
// VideoFallbackGuard.astro
// Agrega este componente UNA VEZ por página (en el layout o en cada página que use CldVideoPlayer).
// Detecta fallos de Cloudinary y activa automáticamente el video local como respaldo.
// No toca nada si Cloudinary funciona correctamente.
// El fallback carga perezoso (data-src, no src) para no descargarlo si Cloudinary si sirve.
// En produccion, si PUBLIC_VIDEO_FALLBACK_BASE esta seteado (Vercel Blob), el fallback
// se sirve desde ahi en vez de /videos/... local (public/videos no se despliega).
---
<script define:vars={{ BLOB_BASE: import.meta.env.PUBLIC_VIDEO_FALLBACK_BASE || '' }}>
  function resolveUrl(p) {
    if (!p) return p;
    return BLOB_BASE ? BLOB_BASE.replace(/\/$/, '') + p : p;
  }

  function setupFallbacks() {
    document.querySelectorAll('[data-fallback-wrap]').forEach((wrap) => {
      const fallback = wrap.querySelector('video[data-role="fallback"]');
      if (!fallback) return;

      // El video primario es cualquier <video> que NO sea el fallback
      const primary = [...wrap.querySelectorAll('video')]
        .find(v => v.dataset.role !== 'fallback');
      if (!primary) return;

      let activated = false;
      let timer;
      let stallTimer;

      function activate() {
        if (activated) return;
        activated = true;
        clearTimeout(timer);
        clearTimeout(stallTimer);

        // Cargar el fallback recien ahora (perezoso) — nunca antes de saber que hace falta
        if (!fallback.getAttribute('src') && fallback.dataset.src) {
          fallback.src = resolveUrl(fallback.dataset.src);
          fallback.load();
        }

        // Mostrar el fallback con los mismos estilos que el primario
        fallback.style.cssText = [
          'display:block',
          'position:absolute',
          'inset:0',
          'width:100%',
          'height:100%',
          'object-fit:cover',
          'object-position:center',
          'z-index:2',
          'pointer-events:none',
        ].join(';');

        fallback.play().catch(() => {});

        // Ocultar el reproductor de Cloudinary para liberar recursos
        primary.style.display = 'none';
      }

      // 1. Error directo en el elemento <video> o sus <source>
      primary.addEventListener('error', activate, true);

      // 2. Tiempo límite: si en 3 s no ha arrancado, usar fallback
      timer = setTimeout(() => {
        if (primary.readyState < 2) activate();
      }, 3000);

      // 3. Stalled o waiting prolongado → fallback tras 1.5 s adicionales
      function onStall() {
        clearTimeout(stallTimer);
        stallTimer = setTimeout(() => {
          if (primary.readyState < 2) activate();
        }, 1500);
      }
      primary.addEventListener('stalled', onStall);
      primary.addEventListener('waiting', onStall);

      // Cancelar los timers si el video principal arranca bien
      primary.addEventListener('canplay',  () => { clearTimeout(timer); clearTimeout(stallTimer); }, { once: true });
      primary.addEventListener('playing',  () => { clearTimeout(timer); clearTimeout(stallTimer); }, { once: true });
    });
  }

  document.addEventListener('DOMContentLoaded', setupFallbacks);
  document.addEventListener('astro:page-load',  setupFallbacks);
</script>
