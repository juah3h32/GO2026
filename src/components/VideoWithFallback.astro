---
// VideoWithFallback.astro
// Fuente 1: Bunny Stream (mp4 directo) si se pasa bunnyVideoId, si no Cloudinary
// (q_auto:best). Fuente 2: local. Fuente 3: imagen poster como último recurso.

interface Props {
  cloudinaryId?: string;
  bunnyVideoId?: string;
  localFallback: string;
  cloudName?: string;
  poster?: string;
  autoplay?: boolean;
  muted?: boolean;
  loop?: boolean;
  playsinline?: boolean;
  controls?: boolean;
  class?: string;
  id?: string;
  preload?: "auto" | "metadata" | "none";
  productName?: string;
  quality?: "1080p" | "original";
}

const {
  cloudinaryId,
  bunnyVideoId,
  cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME ?? "dfuzfdrat",
  localFallback,
  poster,
  autoplay = false,
  muted = true,
  loop = false,
  playsinline = true,
  controls = false,
  class: className,
  id,
  preload = "metadata",
  productName,
  // 1080p = default para videos autoplay/background (peso liviano).
  // original = para videos on-demand (click/hover), ahi el peso no importa.
  quality = "1080p",
} = Astro.props;

const bunnyPullzone = import.meta.env.PUBLIC_BUNNY_PULLZONE_HOSTNAME;

// Bunny Stream (mp4 fallback directo, sin iframe) tiene prioridad si existe —
// Cloudinary queda como fuente secundaria para videos que aun no migran.
// q_auto:best = máxima calidad sin comprimir de más
const bunnyFile = quality === "original" ? "original.mp4" : "play_1080p.mp4";
const primarySrc = bunnyVideoId
  ? `https://${bunnyPullzone}/${bunnyVideoId}/${bunnyFile}`
  : cloudinaryId
  ? `https://res.cloudinary.com/${cloudName}/video/upload/q_auto:best/${cloudinaryId}.mp4`
  : null;
---

<video
  id={id}
  class={className}
  autoplay={autoplay}
  muted={muted}
  loop={loop}
  playsinline={playsinline}
  controls={controls}
  preload={preload}
  poster={poster}
  data-fallback={localFallback}
  data-poster={poster}
  data-product={productName}
>
  {primarySrc && <source src={primarySrc} type="video/mp4" />}
  <source src={localFallback} type="video/mp4" />
</video>

<script define:vars={{ BLOB_BASE: import.meta.env.PUBLIC_VIDEO_FALLBACK_BASE || '' }}>
  function resolveFallback(localPath) {
    if (!localPath) return localPath;
    return BLOB_BASE ? BLOB_BASE.replace(/\/$/, '') + localPath : localPath;
  }

  function attachFallback(video) {
    // Evitar registrar el listener más de una vez por elemento
    if (video.__fallbackAttached) return;
    video.__fallbackAttached = true;

    const local = resolveFallback(video.dataset.fallback);
    const posterSrc = video.dataset.poster;
    if (!local) return;

    let triedLocal = false;

    function showImageFallback() {
      if (!posterSrc) return;
      const img = document.createElement('img');
      img.src = posterSrc;
      img.alt = '';
      img.setAttribute('aria-hidden', 'true');
      img.className = video.className;
      img.style.cssText = video.style.cssText;
      img.style.objectFit = 'cover';
      video.parentElement?.insertBefore(img, video);
      video.style.display = 'none';
    }

    function switchToLocal() {
      if (triedLocal) { showImageFallback(); return; }
      triedLocal = true;
      // Verificar que el local no esté ya en uso (currentSrc es URL absoluta)
      const currentSrc = video.currentSrc || '';
      if (currentSrc && (currentSrc.endsWith(local) || currentSrc.includes(local))) return;
      video.src = local;
      video.load();
      if (video.autoplay) video.play().catch(showImageFallback);
    }

    // Solo activa fallback en error real (404, red caída, codec no soportado)
    video.addEventListener('error', switchToLocal, true);
  }

  function initFallbacks() {
    document.querySelectorAll('video[data-fallback]').forEach(attachFallback);
  }

  document.addEventListener('DOMContentLoaded', initFallbacks);
  document.addEventListener('astro:page-load', initFallbacks);
</script>
